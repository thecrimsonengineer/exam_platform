        "design-criteria"
      ]
    },
    {
      "id": "csp11.flashcard.work_practice_safety_design",
      "conceptId": "csp11.concept.work_practice_safety_design",
      "version": 1,
      "type": "principle",
      "frontLabel": "Work Practice Safety Design",
      "backDefinition": "Designing work methods and the organization of work so tasks can be performed with hazards removed or risks minimized.",
      "whyItMatters": "Work-practice design can reduce foreseeable exposure by changing how work is arranged, sequenced, accessed, or performed.",
      "keyPoint": "Treat work methods and work organization as design decisions.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c01"
