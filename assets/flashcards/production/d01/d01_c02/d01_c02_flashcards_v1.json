          "locator": "Appendix C > 8. Pre-Startup Safety",
          "primary": false,
          "definitionMode": "educationalParaphrase"
        }
      ],
      "lifecycle": "validated",
      "tags": [
        "process-safety",
        "process-diagram",
        "p-id"
      ]
    },
    {
      "id": "csp11.flashcard.process_operating_limits",
      "conceptId": "csp11.concept.process_operating_limits",
      "version": 1,
      "type": "principle",
      "frontLabel": "Process Operating Limits",
      "backDefinition": "Established safe upper and lower process limits for variables such as temperature, pressure, flow, or composition, together with consequences of deviation.",
      "whyItMatters": "Defined limits help operators recognize unsafe conditions and support procedures for correcting or avoiding process deviations.",
      "keyPoint": "Limits are meaningful only when consequences of deviation are understood.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c02"
      },
      "sourceRefs": [
        {
          "sourceId": "csp11.source.osha.1910_119",
          "locator": "1910.119(d)(2)(i)(D)-(E)",
          "primary": true,
          "definitionMode": "educationalParaphrase"
        }
      ],
      "lifecycle": "validated",
      "tags": [
        "process-safety",
        "operating-limits",
        "process-control"
      ]
    },
    {
      "id": "csp11.flashcard.materials_of_construction",
      "conceptId": "csp11.concept.materials_of_construction",
      "version": 1,
      "type": "term",
      "frontLabel": "Materials of Construction",
      "backDefinition": "The materials selected for process equipment and piping to provide suitable integrity and compatibility for the intended process service.",
      "whyItMatters": "Unsuitable construction materials can contribute to corrosion, degradation, leakage, loss of containment, or failure under process conditions.",
      "keyPoint": "Material selection must fit the chemical and physical process conditions.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c02"
      },
      "sourceRefs": [
        {
          "sourceId": "csp11.source.osha.1910_119",
          "locator": "1910.119(d)(3)(i)(A)",
          "primary": true,
          "definitionMode": "educationalParaphrase"
        }
      ],
      "lifecycle": "validated",
      "tags": [
        "process-safety",
        "materials-of-construction",
        "equipment-integrity"
      ]
    },
    {
      "id": "csp11.flashcard.pressure_relief_system",
      "conceptId": "csp11.concept.pressure_relief_system",
      "version": 1,
      "type": "control",
      "frontLabel": "Pressure Relief System",
      "backDefinition": "Protective process equipment that provides a controlled means to relieve excessive pressure and reduce the risk of pressure-related equipment failure.",
      "whyItMatters": "Relief and vent systems are critical safeguards when process deviations can create pressures beyond equipment design conditions.",
      "keyPoint": "Relief protection is part of process equipment integrity.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c02"
      },
      "sourceRefs": [
        {
          "sourceId": "csp11.source.osha.1910_119",
          "locator": "1910.119(j)(1)(iii) Relief and vent systems and devices",
          "primary": true,
          "definitionMode": "educationalParaphrase"
        }
      ],
      "lifecycle": "validated",
      "tags": [
        "process-safety",
        "pressure-relief",
        "engineering-control"
      ]
    },
    {
      "id": "csp11.flashcard.relief_system_design_basis",
      "conceptId": "csp11.concept.relief_system_design_basis",
      "version": 1,
      "type": "principle",
      "frontLabel": "Relief System Design Basis",
      "backDefinition": "The documented engineering basis that explains the design assumptions and protective requirements used for a process relief system.",
      "whyItMatters": "A defined design basis allows reviewers to determine whether relief protection is appropriate for the process hazards and equipment.",
      "keyPoint": "OSHA PSM requires relief system design and its design basis in process safety information.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c02"
      },
      "sourceRefs": [
        {
          "sourceId": "csp11.source.osha.1910_119",
          "locator": "1910.119(d)(3)(i)(D)",
          "primary": true,
          "definitionMode": "educationalParaphrase"
        }
      ],
      "lifecycle": "validated",
      "tags": [
        "process-safety",
        "pressure-relief",
        "design-basis"
      ]
    },
    {
      "id": "csp11.flashcard.recognized_good_engineering_practices",
      "conceptId": "csp11.concept.recognized_good_engineering_practices",
      "version": 1,
      "type": "principle",
      "frontLabel": "Recognized Good Engineering Practices",
      "backDefinition": "Established engineering practices used to design, maintain, inspect, test, and operate process equipment so its integrity remains suitable for service.",
      "whyItMatters": "Using recognized engineering practices provides a technical benchmark for demonstrating that covered process equipment is appropriately managed.",
      "keyPoint": "OSHA PSM requires documented compliance with recognized and generally accepted good engineering practices.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c02"
      },
      "sourceRefs": [
        {
          "sourceId": "csp11.source.osha.1910_119",
          "locator": "1910.119(d)(3)(ii)-(iii)",
          "primary": true,
          "definitionMode": "educationalParaphrase"
        }
      ],
      "lifecycle": "validated",
      "tags": [
        "process-safety",
        "engineering-practice",
        "equipment-integrity"
      ]
    },
    {
      "id": "csp11.flashcard.pre_startup_safety_review",
      "conceptId": "csp11.concept.pre_startup_safety_review",
      "version": 1,
      "type": "processName",
      "frontLabel": "Pre-Startup Safety Review",
      "backDefinition": "A review before introducing highly hazardous chemicals to a new or significantly modified process to confirm readiness for safe startup.",
      "whyItMatters": "It verifies design conformity, procedures, hazard-analysis or MOC obligations, and training before process hazards are introduced.",
      "keyPoint": "Startup should follow confirmation that required safety elements are ready.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c02"
      },
      "sourceRefs": [
        {
