  "cards": [
    {
      "id": "csp11.flashcard.process_safety_management",
      "conceptId": "csp11.concept.process_safety_management",
      "version": 1,
      "type": "principle",
      "frontLabel": "Process Safety Management",
      "backDefinition": "A systematic approach for managing highly hazardous chemical processes to prevent or minimize catastrophic releases and their consequences.",
      "whyItMatters": "It integrates process design, technology, procedures, maintenance, training, and change control instead of treating major hazards as isolated tasks.",
      "keyPoint": "Process safety manages the whole process, not only individual worker exposure.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c02"
      },
      "sourceRefs": [
        {
          "sourceId": "csp11.source.osha.1910_119",
          "locator": "1910.119 Purpose",
          "primary": true,
          "definitionMode": "educationalParaphrase"
        }
      ],
      "lifecycle": "validated",
      "tags": [
        "process-safety",
        "psm",
        "major-hazards"
      ]
    },
    {
      "id": "csp11.flashcard.process_safety_information",
      "conceptId": "csp11.concept.process_safety_information",
      "version": 1,
      "type": "term",
      "frontLabel": "Process Safety Information",
      "backDefinition": "Written information describing process chemical hazards, process technology, and process equipment before the process hazard analysis is performed.",
      "whyItMatters": "Accurate process information gives hazard-analysis, operating, maintenance, and emergency teams a common technical basis for safe decisions.",
      "keyPoint": "PSI covers chemicals, process technology, and process equipment.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c02"
      },
      "sourceRefs": [
        {
          "sourceId": "csp11.source.osha.1910_119",
          "locator": "1910.119(d) Process safety information",
          "primary": true,
          "definitionMode": "educationalParaphrase"
        },
        {
          "sourceId": "csp11.source.osha.1910_119_app_c",
          "locator": "Appendix C > 3. Process Safety Information",
          "primary": false,
          "definitionMode": "educationalParaphrase"
        }
      ],
      "lifecycle": "validated",
      "tags": [
        "process-safety",
        "process-information",
        "psm"
      ]
    },
    {
      "id": "csp11.flashcard.chemical_compatibility_process_safety",
      "conceptId": "csp11.concept.chemical_compatibility_process_safety",
      "version": 1,
      "type": "principle",
      "frontLabel": "Chemical Compatibility in Process Safety",
      "backDefinition": "Evaluation of whether process chemicals, materials, and foreseeable mixtures can coexist without dangerous reactivity, instability, corrosion, or other hazardous effects.",
      "whyItMatters": "Compatibility information helps prevent unintended reactions, equipment damage, overpressure, releases, and unsafe material selection.",
      "keyPoint": "Consider foreseeable inadvertent mixing, not only intended chemistry.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c02"
      },
      "sourceRefs": [
        {
          "sourceId": "csp11.source.osha.1910_119",
          "locator": "1910.119(d)(1)(iv)-(vii)",
          "primary": true,
          "definitionMode": "educationalParaphrase"
        }
      ],
      "lifecycle": "validated",
      "tags": [
        "process-safety",
        "chemical-compatibility",
        "reactivity"
      ]
    },
    {
      "id": "csp11.flashcard.process_flow_diagram",
      "conceptId": "csp11.concept.process_flow_diagram",
      "version": 1,
      "type": "model",
      "frontLabel": "Process Flow Diagram",
      "backDefinition": "A process diagram showing major equipment and principal flow streams so the process sequence, conditions, and technology can be understood.",
      "whyItMatters": "A clear process flow view supports hazard analysis by showing how major equipment and material streams interact.",
      "keyPoint": "A PFD is less detailed than a P&ID.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c02"
      },
      "sourceRefs": [
        {
          "sourceId": "csp11.source.osha.1910_119",
          "locator": "1910.119(d)(2)(i)(A)",
          "primary": true,
          "definitionMode": "educationalParaphrase"
        },
        {
          "sourceId": "csp11.source.osha.1910_119_app_c",
          "locator": "Appendix C > 3. Process Safety Information > process flow diagrams",
          "primary": false,
          "definitionMode": "educationalParaphrase"
        }
      ],
      "lifecycle": "validated",
      "tags": [
        "process-safety",
        "process-diagram",
        "pfd"
      ]
    },
    {
      "id": "csp11.flashcard.piping_and_instrumentation_diagram",
      "conceptId": "csp11.concept.piping_and_instrumentation_diagram",
      "version": 1,
      "type": "model",
      "frontLabel": "Piping and Instrumentation Diagram",
      "backDefinition": "A detailed process drawing that represents piping, equipment, instrumentation, and control relationships used to understand the process configuration.",
      "whyItMatters": "P&IDs support safe operation, hazard review, maintenance, and change control by documenting how process equipment and controls are connected.",
      "keyPoint": "P&IDs are required process equipment information under OSHA PSM.",
      "primaryPlacement": {
        "domainId": "d01",
        "competencyId": "d01_c02"
      },
      "sourceRefs": [
        {
          "sourceId": "csp11.source.osha.1910_119",
          "locator": "1910.119(d)(3)(i)(B)",
          "primary": true,
          "definitionMode": "educationalParaphrase"
        },
        {
