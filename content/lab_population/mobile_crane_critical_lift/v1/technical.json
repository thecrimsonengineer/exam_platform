  "nodes": [
    {
      "id": "lift_plan_decision",
      "type": "DECISION",
      "prompt": "A vessel spool must be lifted beside operating equipment. The drawing weight is old and the crane has been repositioned since the lift plan was issued. What do you do?",
      "options": [
        {
          "id": "lift_plan_decision_o1",
          "text": "Confirm crane capacity, radius and outrigger support, but accept the drawing weight because the spool dimensions appear unchanged from the issued plan. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "lift_plan_decision_defensible",
          "mistakeTags": [
            "lift_plan_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "lifting_operations"
          ]
        },
        {
          "id": "lift_plan_decision_o2",
          "text": "Proceed with the planned crane setup while the rigger confirms the weight from markings on the spool before the load is raised above knee height.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "lift_plan_decision_weak",
          "mistakeTags": [
            "lift_plan_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "lifting_operations"
          ]
        },
        {
          "id": "lift_plan_decision_o3",
          "text": "Start the lift slowly based on the operator's capacity margin and stop if the crane indicators show the load is heavier than expected.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "lift_plan_decision_critical",
          "mistakeTags": [
            "lift_plan_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "lifting_operations"
          ]
        },
        {
          "id": "lift_plan_decision_o4",
          "text": "Stop the lift setup until load weight and centre of gravity, crane configuration, radius, ground support and the current lift plan are verified together.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "lift_plan_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "lifting_operations"
          ]
        }
      ]
    },
    {
      "id": "rigging_decision",
      "type": "DECISION",
      "prompt": "The load data is confirmed. One lifting point was repaired during fabrication and the sling arrangement creates significant sling angles. What do you do?",
      "options": [
        {
          "id": "rigging_decision_o1",
          "text": "Inspect all rigging and confirm sling capacities, but accept the repaired lifting point from the fabrication drawing without checking its release documentation. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "rigging_decision_defensible",
          "mistakeTags": [
            "rigging_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "mobile_crane"
          ]
        },
        {
          "id": "rigging_decision_o2",
          "text": "Verify certified lifting points, inspect slings and shackles, calculate the effect of sling angles and confirm the rigging arrangement before connecting the load.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "rigging_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "mobile_crane"
          ]
        },
        {
          "id": "rigging_decision_o3",
          "text": "Use the listed sling capacities because each sling exceeds one quarter of the load, then control any imbalance with tag lines during the trial lift.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "rigging_decision_weak",
          "mistakeTags": [
            "rigging_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "mobile_crane"
          ]
        },
        {
          "id": "rigging_decision_o4",
          "text": "Add a higher-capacity sling to the arrangement and proceed while the repaired lifting point remains in service without independent acceptance evidence.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "rigging_decision_critical",
          "mistakeTags": [
            "rigging_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "mobile_crane"
          ]
        }
      ]
    },
    {
      "id": "exclusion_decision",
      "type": "DECISION",
      "prompt": "The load is ready to move across a narrow access route used by contractors. Radio coverage is good but people continue approaching the boundary. What do you do?",
      "options": [
        {
          "id": "exclusion_decision_o1",
          "text": "Use a controlled exclusion zone and one signal person, but allow brief pedestrian crossing behind the crane between load movements under spotter control. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "exclusion_decision_defensible",
          "mistakeTags": [
            "exclusion_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "rigging"
          ]
        },
        {
          "id": "exclusion_decision_o2",
          "text": "Keep the route open and rely on the banksman to hold pedestrians whenever the suspended load reaches the access crossing.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "exclusion_decision_weak",
          "mistakeTags": [
            "exclusion_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "rigging"
          ]
        },
        {
          "id": "exclusion_decision_o3",
          "text": "Stop conflicting access, establish a controlled exclusion zone, confirm one designated signal person and test communications before moving the suspended load.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "exclusion_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "rigging"
          ]
        },
        {
          "id": "exclusion_decision_o4",
          "text": "Lift across the occupied route at low height while spotters control pedestrians because the move takes less than a minute.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "exclusion_decision_critical",
          "mistakeTags": [
            "exclusion_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "rigging"
          ]
        }
      ]
    },
    {
      "id": "wind_decision",
      "type": "DECISION",
      "prompt": "Halfway through the lift, gusts increase and the long spool begins to yaw despite the tag lines. The wind remains below the crane's published limit. What do you do?",
      "options": [
        {
          "id": "wind_decision_o1",
          "text": "Land the load in the nearest planned safe position, stop the lift and reassess wind, sail area, rigging and route conditions before any restart.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "wind_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "exclusion_zone"
          ]
        },
        {
          "id": "wind_decision_o2",
          "text": "Hold the load low and stable while wind conditions are confirmed, then land it if the gusting trend continues rather than advancing the lift. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "wind_decision_defensible",
          "mistakeTags": [
            "wind_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "exclusion_zone"
          ]
        },
        {
          "id": "wind_decision_o3",
          "text": "Continue slowly with additional tag-line control because measured wind remains below the published operating limit for the crane.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "wind_decision_weak",
          "mistakeTags": [
            "wind_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "exclusion_zone"
          ]
        },
        {
          "id": "wind_decision_o4",
          "text": "Raise the load above the nearby structure quickly to reduce the time exposed to gusts, then complete the move before wind increases further.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "wind_decision_critical",
          "mistakeTags": [
            "wind_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "exclusion_zone"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The load is landed safely after a sharp yaw and a sling shows fresh abrasion. No contact occurred. What should happen before another lift?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Stop and replace the damaged sling, inspect the remaining rigging and conduct a controlled re-brief before continuing under the existing lift plan. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "weather"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Replace the sling and resume after the operator and rigger agree that the wind has reduced and the load is stable during a short trial lift.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "weather"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Resume with the same arrangement once wind drops because the load was landed without contact and the damaged sling has been removed.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "weather"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "Quarantine the affected rigging, inspect the crane, load and lifting points, record the near miss and revise the lift plan before authorizing another lift.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "weather"
          ]
        }
      ]
    }
  ],
