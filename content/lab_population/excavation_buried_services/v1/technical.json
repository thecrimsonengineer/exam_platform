  "nodes": [
    {
      "id": "utility_location_decision",
      "type": "DECISION",
      "prompt": "A 2.4 m trench is planned across an old utility corridor. Drawings show power and gas services, but recent modifications are not fully marked. What do you do first?",
      "options": [
        {
          "id": "utility_location_decision_o1",
          "text": "Verify the permit and utility information, contact owners, scan the route and safely expose exact service locations before mechanical excavation approaches them.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "utility_location_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "excavation"
          ]
        },
        {
          "id": "utility_location_decision_o2",
          "text": "Scan and mark the services, but rely on the latest drawing for their depth because the route was surveyed during the previous project. under documented supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "utility_location_decision_defensible",
          "mistakeTags": [
            "utility_location_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "excavation"
          ]
        },
        {
          "id": "utility_location_decision_o3",
          "text": "Begin controlled hand excavation around the marked services while mechanical excavation starts in the apparently clear section of the corridor.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "utility_location_decision_weak",
          "mistakeTags": [
            "utility_location_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "excavation"
          ]
        },
        {
          "id": "utility_location_decision_o4",
          "text": "Use the locator markings as the excavation limit and proceed mechanically because the scan shows no additional services between the marked lines.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "utility_location_decision_critical",
          "mistakeTags": [
            "utility_location_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "excavation"
          ]
        }
      ]
    },
    {
      "id": "trench_protection_decision",
      "type": "DECISION",
      "prompt": "The excavation reaches 2.2 m in mixed soil. Space is tight, groundwater is seeping in and spoil has accumulated near one edge. What do you do?",
      "options": [
        {
          "id": "trench_protection_decision_o1",
          "text": "Install the trench box and safe access, but leave some spoil near the edge while a spotter watches for movement because relocation space is limited. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "trench_protection_decision_defensible",
          "mistakeTags": [
            "trench_protection_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "buried_services"
          ]
        },
        {
          "id": "trench_protection_decision_o2",
          "text": "Pump the water, bench the more unstable side and allow short-duration entry while the competent person remains at the trench.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "trench_protection_decision_weak",
          "mistakeTags": [
            "trench_protection_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "buried_services"
          ]
        },
        {
          "id": "trench_protection_decision_o3",
          "text": "Have the competent person reassess soil and water conditions, install an adequate protective system, control spoil loading and provide safe access before entry.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "trench_protection_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "buried_services"
          ]
        },
        {
          "id": "trench_protection_decision_o4",
          "text": "Allow entry after pumping because the sides have stood unsupported during excavation and the job inside the trench will take only a few minutes.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "trench_protection_decision_critical",
          "mistakeTags": [
            "trench_protection_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "buried_services"
          ]
        }
      ]
    },
    {
      "id": "service_change_decision",
      "type": "DECISION",
      "prompt": "A cable is exposed 600 mm away from the mapped position and its identification does not match the drawing. The gas line remains nearby. What do you do?",
      "options": [
        {
          "id": "service_change_decision_o1",
          "text": "Pause mechanical excavation and expose more of the cable by hand while the supervisor contacts the utility owner to confirm its identity. with a written check.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "service_change_decision_defensible",
          "mistakeTags": [
            "service_change_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "trench_safety"
          ]
        },
        {
          "id": "service_change_decision_o2",
          "text": "Stop excavation, protect and support the exposed service, confirm its identity and exact route with the owner, then revise the permit and excavation controls.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "service_change_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "trench_safety"
          ]
        },
        {
          "id": "service_change_decision_o3",
          "text": "Continue mechanical excavation on the opposite side of the trench while maintaining a larger clearance from the unexpected cable.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "service_change_decision_weak",
          "mistakeTags": [
            "service_change_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "trench_safety"
          ]
        },
        {
          "id": "service_change_decision_o4",
          "text": "Treat the cable as redundant based on the drawing and continue under a dedicated spotter because it appears undamaged and inactive.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "service_change_decision_critical",
          "mistakeTags": [
            "service_change_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "trench_safety"
          ]
        }
      ]
    },
    {
      "id": "collapse_decision",
      "type": "DECISION",
      "prompt": "Cracking appears at the trench edge and a worker reports a gas odour after the excavator disturbed soil beside the exposed service. What do you do?",
      "options": [
        {
          "id": "collapse_decision_o1",
          "text": "Evacuate workers and stop equipment while the competent person assesses from outside, contacting the utility owner after confirming whether gas is present.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "collapse_decision_defensible",
          "mistakeTags": [
            "collapse_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "competent_person"
          ]
        },
        {
          "id": "collapse_decision_o2",
          "text": "Keep workers out of the trench but use the excavator from outside to pull loose material away from the suspected service before calling the utility owner.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "collapse_decision_weak",
          "mistakeTags": [
            "collapse_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "competent_person"
          ]
        },
        {
          "id": "collapse_decision_o3",
          "text": "Send one worker down the protected end of the trench to close the visible service valve while others remain clear and emergency support is called.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "collapse_decision_critical",
          "mistakeTags": [
            "collapse_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "competent_person"
          ]
        },
        {
          "id": "collapse_decision_o4",
          "text": "Evacuate the trench, stop plant, isolate the area, raise the emergency response and contact the utility owner before any approach or re-entry.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "collapse_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "competent_person"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The gas service is made safe and the excavation is stable. The contractor wants to continue before the road closure expires. What should happen?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Revise the excavation plan, verify service protection and trench support, complete a competent-person inspection and reauthorize the permit before restarting.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Repair the protective system, confirm the service is safe and conduct a controlled restart review, but keep the original excavation sequence. under supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Resume after water is removed, the trench box is repositioned and the crew is re-briefed on the newly identified service location.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "Resume once the gas leak is isolated and the trench walls appear stable because delaying the work will extend the road closure.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response"
          ]
        }
      ]
    }
  ],
  "gates": [
