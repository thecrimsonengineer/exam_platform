  "nodes": [
    {
      "id": "loading_authorization_decision",
      "type": "DECISION",
      "prompt": "A tank truck arrives for a flammable product. The previous cargo is compatible, but the vehicle earth point is dirty and a nearby contractor is using portable equipment. What do you do?",
      "options": [
        {
          "id": "loading_authorization_decision_o1",
          "text": "Clean and connect the bonding lead, verify product and capacity, but allow the contractor's portable equipment to continue outside the marked loading bay. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "loading_authorization_decision_defensible",
          "mistakeTags": [
            "loading_authorization_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "flammable_liquids"
          ]
        },
        {
          "id": "loading_authorization_decision_o2",
          "text": "Connect the bonding lead and begin hose setup while the supervisor confirms whether the nearby portable equipment is suitable for the hazardous area.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "loading_authorization_decision_weak",
          "mistakeTags": [
            "loading_authorization_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "flammable_liquids"
          ]
        },
        {
          "id": "loading_authorization_decision_o3",
          "text": "Hold loading until vehicle condition, bonding or grounding, ignition-source control, product compatibility and the loading checklist are verified for this transfer.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "loading_authorization_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "flammable_liquids"
          ]
        },
        {
          "id": "loading_authorization_decision_o4",
          "text": "Start loading at minimum flow after bonding because the contractor is outside the immediate bay and the vehicle carries a compatible previous cargo.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "loading_authorization_decision_critical",
          "mistakeTags": [
            "loading_authorization_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "flammable_liquids"
          ]
        }
      ]
    },
    {
      "id": "overfill_decision",
      "type": "DECISION",
      "prompt": "The truck is connected. The high-level shutdown test was recorded last week, but today's functional status has not been checked. What do you do?",
      "options": [
        {
          "id": "overfill_decision_o1",
          "text": "Confirm the preset quantity and manual stop valve, but rely on last week's overfill-test record because no faults have been reported since. and document the check.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "overfill_decision_defensible",
          "mistakeTags": [
            "overfill_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "tank_truck_loading"
          ]
        },
        {
          "id": "overfill_decision_o2",
          "text": "Start at low flow while the operator watches the level indication and test the high-level shutdown before increasing to normal rate.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "overfill_decision_weak",
          "mistakeTags": [
            "overfill_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "tank_truck_loading"
          ]
        },
        {
          "id": "overfill_decision_o3",
          "text": "Load under continuous operator observation without testing the shutdown because the preset volume is below the truck's nominal capacity.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "overfill_decision_critical",
          "mistakeTags": [
            "overfill_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "tank_truck_loading"
          ]
        },
        {
          "id": "overfill_decision_o4",
          "text": "Verify the loading connection, valve lineup, preset quantity and overfill protection before opening flow, with the operator positioned to stop transfer promptly.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "overfill_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "tank_truck_loading"
          ]
        }
      ]
    },
    {
      "id": "simops_decision",
      "type": "DECISION",
      "prompt": "During loading, a contractor vehicle enters the area and the vapour-return indication becomes unstable. No alarm has activated. What do you do?",
      "options": [
        {
          "id": "simops_decision_o1",
          "text": "Pause flow and have the driver remain connected while the supervisor clears the vehicle and checks the vapour-return indication.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "simops_decision_defensible",
          "mistakeTags": [
            "simops_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "bonding"
          ]
        },
        {
          "id": "simops_decision_o2",
          "text": "Stop loading, secure the transfer, remove the conflicting vehicle and verify vapour-control and bonding conditions before restarting.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "simops_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "bonding"
          ]
        },
        {
          "id": "simops_decision_o3",
          "text": "Continue at reduced flow while a spotter keeps the vehicle away from the hose and the operator watches the vapour indication closely.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "simops_decision_weak",
          "mistakeTags": [
            "simops_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "bonding"
          ]
        },
        {
          "id": "simops_decision_o4",
          "text": "Continue because no alarm has activated, asking the contractor vehicle to pass slowly so the loading sequence is not interrupted.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "simops_decision_critical",
          "mistakeTags": [
            "simops_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "bonding"
          ]
        }
      ]
    },
    {
      "id": "spill_fire_decision",
      "type": "DECISION",
      "prompt": "The hose connection leaks and a vapour cloud forms near the truck. A small ignition occurs at ground level. What do you do?",
      "options": [
        {
          "id": "spill_fire_decision_o1",
          "text": "Activate emergency shutdown and alarm, evacuate the loading area, isolate fuel sources if safe and allow the emergency response to control the fire and spill.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "spill_fire_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "overfill_prevention"
          ]
        },
        {
          "id": "spill_fire_decision_o2",
          "text": "Stop transfer and raise the alarm, using available extinguishing equipment only if the fire is incipient and a clear escape route is maintained. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "spill_fire_decision_defensible",
          "mistakeTags": [
            "spill_fire_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "overfill_prevention"
          ]
        },
        {
          "id": "spill_fire_decision_o3",
          "text": "Stop the pump and have the driver disconnect electrical power while the operator uses an extinguisher before ordering a wider evacuation.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "spill_fire_decision_weak",
          "mistakeTags": [
            "spill_fire_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "overfill_prevention"
          ]
        },
        {
          "id": "spill_fire_decision_o4",
          "text": "Try to close the leaking connection and extinguish the small fire first because rapid source control may avoid a full terminal shutdown.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "spill_fire_decision_critical",
          "mistakeTags": [
            "spill_fire_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "overfill_prevention"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The fire is extinguished and the spill is contained. The customer asks whether the remaining load can be completed. What should happen?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Replace the failed hose or seal, retest bonding and overfill protection and conduct a controlled restart review before completing the load. under documented supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "spill_response"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Clean the bay, replace the leaking connection and resume after a successful low-flow leak test because the truck and product remain compatible.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "spill_response"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Keep loading suspended until the leak and ignition cause are investigated, damaged equipment is replaced, safeguards are tested and a fresh authorization is issued.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "spill_response"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "Resume once the fire area is cleaned and the hose stops leaking because the emergency shutdown and extinguisher worked as intended.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "spill_response"
          ]
        }
      ]
    }
  ],
