  "nodes": [
    {
      "id": "energy_identification_decision",
      "type": "DECISION",
      "prompt": "A motor-driven pump is scheduled for internal maintenance. It has a local disconnect, remote controls, a pressurized line and a capacitor bank. What do you do first?",
      "options": [
        {
          "id": "energy_identification_decision_o1",
          "text": "Identify the main electrical and process isolations, but rely on maintenance history to confirm the auxiliary control supply and capacitor discharge arrangement. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "energy_identification_decision_defensible",
          "mistakeTags": [
            "energy_identification_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "LOTO"
          ]
        },
        {
          "id": "energy_identification_decision_o2",
          "text": "Stop the pump from the control system and open the local disconnect while the crew identifies any remaining stored-energy sources at the machine.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "energy_identification_decision_weak",
          "mistakeTags": [
            "energy_identification_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "LOTO"
          ]
        },
        {
          "id": "energy_identification_decision_o3",
          "text": "Review the equipment and procedure, identify electrical, control, stored mechanical and process energy, then notify affected people before shutdown and isolation.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "energy_identification_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "LOTO"
          ]
        },
        {
          "id": "energy_identification_decision_o4",
          "text": "Use the emergency stop, open the local disconnect and bleed visible pressure because the maintenance window is too short for a full energy-source review.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "energy_identification_decision_critical",
          "mistakeTags": [
            "energy_identification_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "LOTO"
          ]
        }
      ]
    },
    {
      "id": "isolation_verification_decision",
      "type": "DECISION",
      "prompt": "The pump is stopped and isolation points are available. What is the strongest verification before hands-on work begins?",
      "options": [
        {
          "id": "isolation_verification_decision_o1",
          "text": "Lock the main disconnect and process isolation, test the motor terminals and confirm zero pressure, but omit a functional start attempt after testing. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "isolation_verification_decision_defensible",
          "mistakeTags": [
            "isolation_verification_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "electrical_safety"
          ]
        },
        {
          "id": "isolation_verification_decision_o2",
          "text": "Apply personal locks to every required isolating device, dissipate stored energy, verify absence with an appropriate test method and attempt normal start controls.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "isolation_verification_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "electrical_safety"
          ]
        },
        {
          "id": "isolation_verification_decision_o3",
          "text": "Tag the local disconnect, bleed the line and test one electrical phase to earth before beginning work because the motor cannot start from the local station.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "isolation_verification_decision_weak",
          "mistakeTags": [
            "isolation_verification_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "electrical_safety"
          ]
        },
        {
          "id": "isolation_verification_decision_o4",
          "text": "Remove the control fuses and place a warning tag on the disconnect without locking it because only the maintenance team has access to the area.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "isolation_verification_decision_critical",
          "mistakeTags": [
            "isolation_verification_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "electrical_safety"
          ]
        }
      ]
    },
    {
      "id": "group_loto_decision",
      "type": "DECISION",
      "prompt": "A contractor joins the job and the shift will change before completion. Several workers need protection under the same isolation. What do you do?",
      "options": [
        {
          "id": "group_loto_decision_o1",
          "text": "Use the approved group lockout arrangement, give each protected worker personal control, document the handover and verify isolation before the new crew starts.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "group_loto_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "stored_energy"
          ]
        },
        {
          "id": "group_loto_decision_o2",
          "text": "Use a supervisor-controlled group lock with a signed worker roster, but do not require every worker to apply a personal lock to the group device. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "group_loto_decision_defensible",
          "mistakeTags": [
            "group_loto_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "stored_energy"
          ]
        },
        {
          "id": "group_loto_decision_o3",
          "text": "Transfer the lockbox keys to the incoming supervisor and have the new crew sign the permit without repeating isolation verification.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "group_loto_decision_weak",
          "mistakeTags": [
            "group_loto_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "stored_energy"
          ]
        },
        {
          "id": "group_loto_decision_o4",
          "text": "Remove departing workers' locks under supervisor authority so the incoming crew can continue without interrupting the maintenance sequence.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "group_loto_decision_critical",
          "mistakeTags": [
            "group_loto_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "stored_energy"
          ]
        }
      ]
    },
    {
      "id": "unexpected_energy_decision",
      "type": "DECISION",
      "prompt": "During dismantling, the pump shaft moves and trapped pressure is indicated on a small auxiliary line that was not on the isolation drawing. What do you do?",
      "options": [
        {
          "id": "unexpected_energy_decision_o1",
          "text": "Stop the job and mechanically restrain the shaft while tracing the auxiliary pressure source, keeping the existing lockout in place. under documented supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "unexpected_energy_decision_defensible",
          "mistakeTags": [
            "unexpected_energy_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "group_lockout"
          ]
        },
        {
          "id": "unexpected_energy_decision_o2",
          "text": "Keep hands clear of the shaft and continue electrical diagnostics while operations identifies the auxiliary line and prepares an additional isolation.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "unexpected_energy_decision_weak",
          "mistakeTags": [
            "unexpected_energy_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "group_lockout"
          ]
        },
        {
          "id": "unexpected_energy_decision_o3",
          "text": "Secure the shaft with a hand tool and continue dismantling while the operator bleeds the auxiliary line because the main equipment is already locked out.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "unexpected_energy_decision_critical",
          "mistakeTags": [
            "unexpected_energy_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "group_lockout"
          ]
        },
        {
          "id": "unexpected_energy_decision_o4",
          "text": "Stop work, withdraw from the danger zone, identify and isolate the additional energy source, dissipate it and reverify the complete isolation before restart.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "unexpected_energy_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "group_lockout"
          ]
        }
      ]
    },
    {
      "id": "restoration_decision",
      "type": "DECISION",
      "prompt": "Maintenance is complete. One contractor has left site and their personal lock remains on the group arrangement. How should restoration be managed?",
      "options": [
        {
          "id": "restoration_decision_o1",
          "text": "Confirm the contractor is off site, use the documented management removal procedure and recheck the work area before energizing the equipment. under documented supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "restoration_decision_defensible",
          "mistakeTags": [
            "restoration_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "contractor_control"
          ]
        },
        {
          "id": "restoration_decision_o2",
          "text": "Obtain phone confirmation from the contractor, remove the remaining lock with supervisor approval and energize after the crew stands clear.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "restoration_decision_weak",
          "mistakeTags": [
            "restoration_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "contractor_control"
          ]
        },
        {
          "id": "restoration_decision_o3",
          "text": "Inspect the equipment, restore guards, account for people, follow the formal absent-worker lock-removal procedure and notify affected staff before controlled energization.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "restoration_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "contractor_control"
          ]
        },
        {
          "id": "restoration_decision_o4",
          "text": "Energize briefly with the guard open to verify rotation, then remove the remaining lock and complete reassembly if the test is satisfactory.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "restoration_decision_critical",
          "mistakeTags": [
            "restoration_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "contractor_control"
          ]
        }
      ]
    }
  ],
