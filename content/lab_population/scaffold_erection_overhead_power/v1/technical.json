  "nodes": [
    {
      "id": "clearance_decision",
      "type": "DECISION",
      "prompt": "A scaffold must be erected beside an overhead line whose voltage is not confirmed. Long metal standards will be handled close to the corridor. What do you do first?",
      "options": [
        {
          "id": "clearance_decision_o1",
          "text": "Measure the apparent clearance and use a dedicated spotter while the electrical authority confirms voltage during the first stage of erection. under supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "clearance_decision_defensible",
          "mistakeTags": [
            "clearance_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "scaffolding"
          ]
        },
        {
          "id": "clearance_decision_o2",
          "text": "Start erecting the lower scaffold lifts using shorter components while keeping long standards outside the estimated line-clearance zone.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "clearance_decision_weak",
          "mistakeTags": [
            "clearance_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "scaffolding"
          ]
        },
        {
          "id": "clearance_decision_o3",
          "text": "Proceed with the planned scaffold location because the line appears insulated and the crew can keep metal components below shoulder height.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "clearance_decision_critical",
          "mistakeTags": [
            "clearance_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "scaffolding"
          ]
        },
        {
          "id": "clearance_decision_o4",
          "text": "Hold erection until the line voltage and required clearance are confirmed and the work method provides de-energization, guarding or a verified safe separation.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "clearance_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "scaffolding"
          ]
        }
      ]
    },
    {
      "id": "scaffold_setup_decision",
      "type": "DECISION",
      "prompt": "The electrical clearance is established. The base is partly on compacted fill and the scaffold will carry workers plus heavy tools. What do you do?",
      "options": [
        {
          "id": "scaffold_setup_decision_o1",
          "text": "Verify foundation capacity, base plates and sole boards, ties, bracing and design loading before erection proceeds to the working height.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "scaffold_setup_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "overhead_power_lines"
          ]
        },
        {
          "id": "scaffold_setup_decision_o2",
          "text": "Use sole boards and bracing as planned, but accept one softer base area after adding packing because the first lift remains level. and record it.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "scaffold_setup_decision_defensible",
          "mistakeTags": [
            "scaffold_setup_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "overhead_power_lines"
          ]
        },
        {
          "id": "scaffold_setup_decision_o3",
          "text": "Erect two lifts and monitor settlement before installing additional ties because the scaffold is freestanding at the initial height.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "scaffold_setup_decision_weak",
          "mistakeTags": [
            "scaffold_setup_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "overhead_power_lines"
          ]
        },
        {
          "id": "scaffold_setup_decision_o4",
          "text": "Complete the scaffold and correct any settlement during inspection because the base can be adjusted with screw jacks afterward.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "scaffold_setup_decision_critical",
          "mistakeTags": [
            "scaffold_setup_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "overhead_power_lines"
          ]
        }
      ]
    },
    {
      "id": "material_handling_decision",
      "type": "DECISION",
      "prompt": "Long scaffold tubes must be passed upward near the power-line side. Wind is increasing and the dedicated spotter has been called away temporarily. What do you do?",
      "options": [
        {
          "id": "material_handling_decision_o1",
          "text": "Pause long-tube handling but continue installing short components on the opposite side of the scaffold while waiting for the dedicated spotter to return to the work area.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "material_handling_decision_defensible",
          "mistakeTags": [
            "material_handling_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "electrical_hazard"
          ]
        },
        {
          "id": "material_handling_decision_o2",
          "text": "Stop material movement until the spotter and required clearance controls are restored, then handle long components using the approved method within the safe zone.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "material_handling_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "electrical_hazard"
          ]
        },
        {
          "id": "material_handling_decision_o3",
          "text": "Continue passing tubes horizontally on the far side because the scaffold structure now provides a visible reference for maintaining clearance.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "material_handling_decision_weak",
          "mistakeTags": [
            "material_handling_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "electrical_hazard"
          ]
        },
        {
          "id": "material_handling_decision_o4",
          "text": "Continue one tube at a time with an erector watching the line because stopping would leave the scaffold partially complete in rising wind.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "material_handling_decision_critical",
          "mistakeTags": [
            "material_handling_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "electrical_hazard"
          ]
        }
      ]
    },
    {
      "id": "contact_decision",
      "type": "DECISION",
      "prompt": "A metal tube swings toward the line and an arc occurs. One worker is holding the scaffold but remains standing. What do you do?",
      "options": [
        {
          "id": "contact_decision_o1",
          "text": "Warn the worker not to move, isolate the area and call the electrical authority while preparing first aid and rescue resources at a safe distance. under supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "contact_decision_defensible",
          "mistakeTags": [
            "contact_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "material_handling"
          ]
        },
        {
          "id": "contact_decision_o2",
          "text": "Tell the worker to step away carefully without touching other metal while another person calls the electrical authority to isolate the line.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "contact_decision_weak",
          "mistakeTags": [
            "contact_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "material_handling"
          ]
        },
        {
          "id": "contact_decision_o3",
          "text": "Keep people away from the scaffold, raise the emergency response and have the supply made safe by the electrical authority before anyone approaches or touches it.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "contact_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "material_handling"
          ]
        },
        {
          "id": "contact_decision_o4",
          "text": "Pull the worker away using a dry nonconductive object because there is no visible flame and immediate separation may prevent further exposure.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "contact_decision_critical",
          "mistakeTags": [
            "contact_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "material_handling"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The line is isolated and no injury is confirmed. The scaffold and tube show arc damage. How should the work resume?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Replace damaged components, reconfirm line isolation and conduct a controlled re-brief before resuming under the revised local setup. under documented supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Replace the damaged tube and resume once a spotter is present because the power line is now isolated for the remainder of the shift.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Resume with the same scaffold after removing damaged parts because the line is isolated and the immediate electrical hazard has been removed.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "Quarantine damaged components, investigate the clearance failure, revise the scaffold and electrical-control plan and reauthorize work before erection restarts.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response"
          ]
        }
      ]
    }
  ],
