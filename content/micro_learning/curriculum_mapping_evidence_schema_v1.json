{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csp11.local/schemas/micro_fact_curriculum_mapping_evidence_v1.schema.json",
  "title": "CSP11 MicroFact Curriculum Mapping Evidence v1",
  "description": "ML-6 audit record binding one mapped MicroFact version to the frozen canonical curriculum hierarchy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "microFactId",
    "contentVersion",
    "blueprintVersion",
    "navigationRegistryVersion",
    "mapping",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^mfme_[a-z0-9][a-z0-9_-]{5,63}$"
    },
    "microFactId": {
      "type": "string",
      "pattern": "^mf_[a-z0-9][a-z0-9_-]{5,63}$"
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "blueprintVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "navigationRegistryVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "domainId",
        "competencyId",
        "topicId",
        "subtopicId",
        "mappingKey"
      ],
      "properties": {
        "scope": {
          "const": "mapped"
        },
        "domainId": {
          "type": "string",
          "pattern": "^d0[1-7]$"
        },
        "competencyId": {
          "type": "string",
          "pattern": "^d0[1-7]_c[0-9]{2}$"
        },
        "topicId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^d0[1-7]_c[0-9]{2}_t[0-9]{2}$"
        },
        "subtopicId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^d0[1-7]_c[0-9]{2}_t[0-9]{2}_s[0-9]{2}$"
        },
        "mappingKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewerRole",
        "humanReviewed",
        "conceptAlignmentConfirmed",
        "placementRationale",
        "reviewedAt",
        "nextReviewDueAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "reviewerRole": {
          "enum": [
            "curriculum_reviewer",
            "content_governance_reviewer",
            "subject_matter_reviewer"
          ]
        },
        "humanReviewed": {
          "type": "boolean"
        },
        "conceptAlignmentConfirmed": {
          "type": "boolean"
        },
        "placementRationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "nextReviewDueAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    }
  },
  "x-csp11": {
    "phase": "ML-6",
    "curriculumPolicyVersion": "1.0.0",
    "failClosed": true
  }
}
