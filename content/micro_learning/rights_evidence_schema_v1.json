{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csp11.local/schemas/micro_fact_rights_evidence_v1.schema.json",
  "title": "CSP11 MicroFact Rights Evidence v1",
  "description": "ML-5 audit record proving the rights treatment and provenance basis for one MicroFact version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceId",
    "microFactId",
    "contentVersion",
    "rightsTreatment",
    "sourceFingerprint",
    "transformation",
    "license",
    "review",
    "restrictedMaterial"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^mfre_[a-z0-9][a-z0-9_-]{5,63}$"
    },
    "microFactId": {
      "type": "string",
      "pattern": "^mf_[a-z0-9][a-z0-9_-]{5,63}$"
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "rightsTreatment": {
      "enum": [
        "original_paraphrase",
        "brief_summary",
        "minimal_quote",
        "licensed_excerpt"
      ]
    },
    "sourceFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRegistryId",
        "officialUrl",
        "sourceLocator",
        "editionOrRevision"
      ],
      "properties": {
        "sourceRegistryId": {
          "type": "string",
          "pattern": "^SRC-[0-9]{2}$"
        },
        "officialUrl": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 1000
        },
        "sourceLocator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "editionOrRevision": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceComparisonPerformed",
        "independentWordingConfirmed",
        "directQuoteUsed",
        "quoteWordCount",
        "quoteSegmentCount",
        "quoteTextSha256",
        "quoteNecessity",
        "longestVerbatimRunWords",
        "sourceStructureCopied",
        "tableCopied",
        "figureOrDiagramCopied",
        "checklistCopied",
        "questionOrAnswerCopied",
        "workedExampleCopied"
      ],
      "properties": {
        "sourceComparisonPerformed": {
          "type": "boolean"
        },
        "independentWordingConfirmed": {
          "type": "boolean"
        },
        "directQuoteUsed": {
          "type": "boolean"
        },
        "quoteWordCount": {
          "type": "integer",
          "minimum": 0
        },
        "quoteSegmentCount": {
          "type": "integer",
          "minimum": 0
        },
        "quoteTextSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "quoteNecessity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 250
        },
        "longestVerbatimRunWords": {
          "type": "integer",
          "minimum": 0
        },
        "sourceStructureCopied": {
          "type": "boolean"
        },
        "tableCopied": {
          "type": "boolean"
        },
        "figureOrDiagramCopied": {
          "type": "boolean"
        },
        "checklistCopied": {
          "type": "boolean"
        },
        "questionOrAnswerCopied": {
          "type": "boolean"
        },
        "workedExampleCopied": {
          "type": "boolean"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "licenseId",
        "licensor",
        "scope",
        "effectiveDate",
        "expiresAt",
        "startupDisplayPermitted",
        "digitalRedistributionPermitted",
        "protectedStructureReusePermitted"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "licenseId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120
        },
        "licensor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500
        },
        "effectiveDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "startupDisplayPermitted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "digitalRedistributionPermitted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "protectedStructureReusePermitted": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewerRole",
        "humanReviewed",
        "reviewedAt",
        "nextReviewDueAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "reviewerRole": {
          "enum": [
            "copyright_reviewer",
            "content_governance_reviewer",
            "legal_or_rights_reviewer"
          ]
        },
        "humanReviewed": {
          "type": "boolean"
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "nextReviewDueAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    },
    "restrictedMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawSourceDocumentStored",
        "fullStandardStored",
        "fullBookChapterStored",
        "paywalledSnapshotStored",
        "copyrightedTableImageStored",
        "thirdPartyMaterialPresent",
        "thirdPartyMaterialCleared"
      ],
      "properties": {
        "rawSourceDocumentStored": {
          "type": "boolean"
        },
        "fullStandardStored": {
          "type": "boolean"
        },
        "fullBookChapterStored": {
          "type": "boolean"
        },
        "paywalledSnapshotStored": {
          "type": "boolean"
        },
        "copyrightedTableImageStored": {
          "type": "boolean"
        },
        "thirdPartyMaterialPresent": {
          "type": "boolean"
        },
        "thirdPartyMaterialCleared": {
          "type": "boolean"
        }
      }
    }
  },
  "x-csp11": {
    "phase": "ML-5",
    "rightsPolicyVersion": "1.0.0",
    "failClosed": true
  }
}
