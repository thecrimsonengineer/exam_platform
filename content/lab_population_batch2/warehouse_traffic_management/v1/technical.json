  "nodes": [
    {
      "id": "prejob_decision",
      "type": "DECISION",
      "prompt": "Pallets now block sight lines at a marked forklift and pedestrian crossing during a busy loading period. What should the supervisor do first?",
      "options": [
        {
          "id": "prejob_decision_o1",
          "text": "Add warning cones and require horns at the crossing while leaving the pallets in place. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "prejob_decision_defensible",
          "mistakeTags": [
            "prejob_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "prejob_decision_o2",
          "text": "Restore visibility or separate the routes, establish clear right-of-way controls and brief operators and pedestrians before traffic continues.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "prejob_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "prejob_decision_o3",
          "text": "Assign a spotter and keep traffic moving while workers gradually relocate the pallets.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "prejob_decision_weak",
          "mistakeTags": [
            "prejob_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "prejob_decision_o4",
          "text": "Continue normal traffic because the crossing is already marked on the floor.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "prejob_decision_critical",
          "mistakeTags": [
            "prejob_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        }
      ]
    },
    {
      "id": "controls_decision",
      "type": "DECISION",
      "prompt": "A forklift is ready to enter a trailer, but the trailer restraint status is uncertain. What is the best next action?",
      "options": [
        {
          "id": "controls_decision_o1",
          "text": "Use wheel chocks and allow slow entry while the restraint indicator is checked.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "controls_decision_defensible",
          "mistakeTags": [
            "controls_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "controls_decision_o2",
          "text": "Stage the first pallet at the dock edge while the driver confirms the parking brake. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "controls_decision_weak",
          "mistakeTags": [
            "controls_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "controls_decision_o3",
          "text": "Enter because the tractor remains attached and the dock plate is already positioned.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "controls_decision_critical",
          "mistakeTags": [
            "controls_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "controls_decision_o4",
          "text": "Hold entry until the trailer is positively secured and the dock interface is verified for safe loading.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "controls_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        }
      ]
    },
    {
      "id": "change_decision",
      "type": "DECISION",
      "prompt": "A spill diverts pedestrians toward the edge of an active forklift lane during the busiest loading period. What should happen before traffic continues?",
      "options": [
        {
          "id": "change_decision_o1",
          "text": "Stop conflicting traffic, isolate and clean the spill, provide protected pedestrian access and reopen only after separation is restored.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "change_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "change_decision_o2",
          "text": "Reduce forklift speed and let pedestrians use the lane edge during cleanup.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "change_decision_defensible",
          "mistakeTags": [
            "change_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "change_decision_o3",
          "text": "Use a walking spotter for each forklift while loading continues. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "change_decision_weak",
          "mistakeTags": [
            "change_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "change_decision_o4",
          "text": "Continue because pedestrians can see the forklifts in the open portion of the aisle. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "change_decision_critical",
          "mistakeTags": [
            "change_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        }
      ]
    },
    {
      "id": "response_decision",
      "type": "DECISION",
      "prompt": "A reversing forklift narrowly misses a pedestrian emerging from behind stored material. What is the best response?",
      "options": [
        {
          "id": "response_decision_o1",
          "text": "Speak with both workers and continue loading while the supervisor records the near miss.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "response_decision_defensible",
          "mistakeTags": [
            "response_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "response_decision_o2",
          "text": "Move the nearest pallet stack and tell the operator to use the horn more often. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "response_decision_weak",
          "mistakeTags": [
            "response_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "response_decision_o3",
          "text": "Stop affected traffic, secure the area, correct the visibility and route controls, and brief workers before resuming.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "response_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "response_decision_o4",
          "text": "Continue because no contact occurred and both workers understand the event. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "response_decision_critical",
          "mistakeTags": [
            "response_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The obstructions are removed and the spill is cleaned. What should occur before normal traffic resumes?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Reopen at reduced speed and remove temporary barriers after observing a few vehicle movements. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Walk down the route, verify sight lines and pedestrian separation, confirm dock controls and formally reopen the traffic plan.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Remove barriers and complete the final route inspection while operations continue.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "Resume normal traffic immediately because the physical obstructions are gone. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "warehouse_safety"
          ]
        }
      ]
    }
