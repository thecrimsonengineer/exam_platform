  "nodes": [
    {
      "id": "prejob_decision",
      "type": "DECISION",
      "prompt": "The shift will extend beyond the planned finish and a critical task is still pending. What should the supervisor do first?",
      "options": [
        {
          "id": "prejob_decision_o1",
          "text": "Ask workers whether they feel able to continue and proceed if nobody reports significant fatigue. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "prejob_decision_defensible",
          "mistakeTags": [
            "prejob_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "prejob_decision_o2",
          "text": "Reassess staffing, task criticality and fatigue risk, redistribute or defer work where necessary, and set additional recovery and supervision controls.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "prejob_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "prejob_decision_o3",
          "text": "Keep the original assignments but add an extra coffee break before the critical task.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "prejob_decision_weak",
          "mistakeTags": [
            "prejob_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "prejob_decision_o4",
          "text": "Continue because the extension is only for one shift and the team is experienced.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "prejob_decision_critical",
          "mistakeTags": [
            "prejob_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        }
      ]
    },
    {
      "id": "controls_decision",
      "type": "DECISION",
      "prompt": "One worker has been awake much longer than the others but is the most experienced person for the next task. What is the best action?",
      "options": [
        {
          "id": "controls_decision_o1",
          "text": "Let the experienced worker lead alone because familiarity reduces the likelihood of error.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "controls_decision_defensible",
          "mistakeTags": [
            "controls_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "controls_decision_o2",
          "text": "Assign a less experienced worker to perform the task with direct checking, while the fatigued expert remains available to advise without carrying the full workload.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "controls_decision_weak",
          "mistakeTags": [
            "controls_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "controls_decision_o3",
          "text": "Keep the original plan because changing roles late in the shift may create confusion.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "controls_decision_critical",
          "mistakeTags": [
            "controls_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "controls_decision_o4",
          "text": "Use the worker's expertise without relying on fatigued solo performance, and assign the task so checking, workload and rest controls address the fatigue risk.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "controls_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        }
      ]
    },
    {
      "id": "change_decision",
      "type": "DECISION",
      "prompt": "A second urgent task arrives while the crew is already behind schedule. What should happen?",
      "options": [
        {
          "id": "change_decision_o1",
          "text": "Reprioritize the work, defer nonessential tasks and ensure staffing and rest remain adequate for the higher-risk activities.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "change_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "change_decision_o2",
          "text": "Split the crew and ask both groups to work faster so all tasks finish before handover.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "change_decision_defensible",
          "mistakeTags": [
            "change_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "change_decision_o3",
          "text": "Cancel the next planned break and use that time to clear the backlog.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "change_decision_weak",
          "mistakeTags": [
            "change_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "change_decision_o4",
          "text": "Continue the existing plan and add the new task at the end of the queue without reassessment.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "change_decision_critical",
          "mistakeTags": [
            "change_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        }
      ]
    },
    {
      "id": "response_decision",
      "type": "DECISION",
      "prompt": "A worker makes two unusual procedural errors within a short period. What is the best response?",
      "options": [
        {
          "id": "response_decision_o1",
          "text": "Remind the worker to concentrate and have a coworker watch the next step closely. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "response_decision_defensible",
          "mistakeTags": [
            "response_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "response_decision_o2",
          "text": "Move the worker to the next task so a change of activity improves alertness.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "response_decision_weak",
          "mistakeTags": [
            "response_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "response_decision_o3",
          "text": "Pause the worker's safety-critical activity, check fitness and fatigue factors, correct the immediate work and adjust duties or staffing before continuing.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "response_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "response_decision_o4",
          "text": "Continue because neither error caused an incident and both were corrected quickly.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "response_decision_critical",
          "mistakeTags": [
            "response_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The extended shift is ending and several tasks remain partially complete. What should happen at handover?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Ask each outgoing worker to brief their replacement informally at the workstation. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Provide a structured handover of work status, hazards, controls and incomplete actions so the incoming team can resume without relying on fatigued memory.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Leave written notes for the day supervisor and let the incoming team inspect the work before starting. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "Finish the highest-priority task after handover time so fewer incomplete items are transferred.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "fatigue"
          ]
        }
      ]
    }
  ],
