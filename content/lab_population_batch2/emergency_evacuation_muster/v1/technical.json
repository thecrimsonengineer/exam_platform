  "nodes": [
    {
      "id": "prejob_decision",
      "type": "DECISION",
      "prompt": "A site alarm activates while one normal exit is closed for maintenance and contractors are working in several areas. What should the coordinator do first?",
      "options": [
        {
          "id": "prejob_decision_o1",
          "text": "Tell departments to evacuate normally and resolve the closed exit only if congestion develops.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "prejob_decision_defensible",
          "mistakeTags": [
            "prejob_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "prejob_decision_o2",
          "text": "Activate the emergency plan, direct occupants to available safe exits and muster points, and begin accountability using current personnel information.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "prejob_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "prejob_decision_o3",
          "text": "Ask contractors to remain at their work areas until employees have cleared the main routes.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "prejob_decision_weak",
          "mistakeTags": [
            "prejob_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "prejob_decision_o4",
          "text": "Wait for confirmation of the emergency type before starting evacuation because the alarm may be precautionary. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "prejob_decision_critical",
          "mistakeTags": [
            "prejob_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        }
      ]
    },
    {
      "id": "controls_decision",
      "type": "DECISION",
      "prompt": "People begin approaching the closed exit before realizing it is unavailable. What is the best response?",
      "options": [
        {
          "id": "controls_decision_o1",
          "text": "Open the maintenance barrier temporarily so people can pass through the familiar exit route.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "controls_decision_defensible",
          "mistakeTags": [
            "controls_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "controls_decision_o2",
          "text": "Let workers choose another path individually while the coordinator focuses on the muster count.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "controls_decision_weak",
          "mistakeTags": [
            "controls_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "controls_decision_o3",
          "text": "Keep the route closed but do not intervene because exit signs will eventually redirect people. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "controls_decision_critical",
          "mistakeTags": [
            "controls_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "controls_decision_o4",
          "text": "Redirect them promptly using trained wardens or clear communication and keep the unusable route controlled so evacuation remains orderly.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "controls_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        }
      ]
    },
    {
      "id": "change_decision",
      "type": "DECISION",
      "prompt": "At the muster point, one contractor cannot be accounted for immediately. What should happen?",
      "options": [
        {
          "id": "change_decision_o1",
          "text": "Treat the person as unaccounted for, verify records and last-known location, inform incident command and avoid sending unprotected personnel back inside.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "change_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "change_decision_o2",
          "text": "Ask the contractor supervisor to search the nearest work area while the coordinator checks the attendance list. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "change_decision_defensible",
          "mistakeTags": [
            "change_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "change_decision_o3",
          "text": "Wait several minutes because contractors sometimes report to a different muster point. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "change_decision_weak",
          "mistakeTags": [
            "change_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "change_decision_o4",
          "text": "Mark the person absent from the day's roster and continue with the remaining accountability process.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "change_decision_critical",
          "mistakeTags": [
            "change_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        }
      ]
    },
    {
      "id": "response_decision",
      "type": "DECISION",
      "prompt": "A coworker says the missing contractor may have left site earlier, but the sign-out record is incomplete. What is the best response?",
      "options": [
        {
          "id": "response_decision_o1",
          "text": "Assume the contractor left because the coworker remembers seeing them near the gate.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "response_decision_defensible",
          "mistakeTags": [
            "response_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "response_decision_o2",
          "text": "Remove the name from the missing list so responders are not distracted by uncertain information. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "response_decision_weak",
          "mistakeTags": [
            "response_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "response_decision_o3",
          "text": "Pass the uncertainty and available evidence to incident command, continue verification and keep the person classified as unaccounted for until confirmed.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "response_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "response_decision_o4",
          "text": "Send another worker to the parking area to look for the contractor's vehicle.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "response_decision_critical",
          "mistakeTags": [
            "response_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The alarm source is controlled and operations wants employees back inside. What should happen before re-entry?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Allow supervisors to return first and decide whether their teams can follow.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Wait for formal all-clear authorization, confirm affected areas and routes are safe, communicate instructions and control re-entry in an orderly way.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Let employees re-enter unaffected areas while the incident coordinator completes the final checks.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "End the muster once the alarm stops because the immediate emergency has been controlled. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_preparedness"
          ]
        }
      ]
    }
  ],
