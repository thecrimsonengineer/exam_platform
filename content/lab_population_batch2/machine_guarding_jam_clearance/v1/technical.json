  "nodes": [
    {
      "id": "prejob_decision",
      "type": "DECISION",
      "prompt": "An operator wants to reach through an opened guard to clear a visible jam after pressing the local stop. What should the supervisor do first?",
      "options": [
        {
          "id": "prejob_decision_o1",
          "text": "Verify the machine is stationary and leave the main disconnect energized for faster troubleshooting. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "prejob_decision_defensible",
          "mistakeTags": [
            "prejob_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "prejob_decision_o2",
          "text": "Stop the task and apply the required energy-control procedure before anyone enters the hazard zone.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "prejob_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "prejob_decision_o3",
          "text": "Use a long tool through the opening while maintenance prepares the isolation equipment.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "prejob_decision_weak",
          "mistakeTags": [
            "prejob_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "prejob_decision_o4",
          "text": "Allow a quick clearance because the operator controls the local stop.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "prejob_decision_critical",
          "mistakeTags": [
            "prejob_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        }
      ]
    },
    {
      "id": "controls_decision",
      "type": "DECISION",
      "prompt": "The electrical disconnect is locked, but pneumatic pressure remains available to an actuator. What is the best action?",
      "options": [
        {
          "id": "controls_decision_o1",
          "text": "Bleed the nearest gauge and rely on the electrical lockout while work begins. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "controls_decision_defensible",
          "mistakeTags": [
            "controls_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "controls_decision_o2",
          "text": "Enter the guarded space and install a mechanical block before releasing the jam.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "controls_decision_weak",
          "mistakeTags": [
            "controls_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "controls_decision_o3",
          "text": "Proceed because the main electrical source is already locked. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "controls_decision_critical",
          "mistakeTags": [
            "controls_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "controls_decision_o4",
          "text": "Isolate and control the stored pneumatic energy, verify zero-energy condition and test against restart before access.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "controls_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        }
      ]
    },
    {
      "id": "change_decision",
      "type": "DECISION",
      "prompt": "After the jam is cleared, the guard interlock fails intermittently during testing. What should happen?",
      "options": [
        {
          "id": "change_decision_o1",
          "text": "Keep the machine out of service, repair the safeguarding defect and verify its function before production restart.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "change_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "change_decision_o2",
          "text": "Operate at reduced speed with a supervisor present while a replacement is ordered. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "change_decision_defensible",
          "mistakeTags": [
            "change_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "change_decision_o3",
          "text": "Run production with the guard closed and instruct operators not to open it.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "change_decision_weak",
          "mistakeTags": [
            "change_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "change_decision_o4",
          "text": "Return to service because the interlock succeeds on most tests. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "change_decision_critical",
          "mistakeTags": [
            "change_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        }
      ]
    },
    {
      "id": "response_decision",
      "type": "DECISION",
      "prompt": "During controlled troubleshooting, the mechanism moves unexpectedly when residual energy is discovered. What is the best response?",
      "options": [
        {
          "id": "response_decision_o1",
          "text": "Add a block to the moving part and continue after the mechanism stops. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "response_decision_defensible",
          "mistakeTags": [
            "response_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "response_decision_o2",
          "text": "Have one technician hold the control valve while another checks the actuator.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "response_decision_weak",
          "mistakeTags": [
            "response_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "response_decision_o3",
          "text": "Stop work, withdraw, re-establish complete energy control and verify the missed source before further troubleshooting.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "response_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "response_decision_o4",
          "text": "Continue because the electrical disconnect remains locked. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "response_decision_critical",
          "mistakeTags": [
            "response_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "Repairs are complete and locks are ready to be removed. What should occur before production resumes?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Remove locks after checking the immediate area and test the interlock during the first production cycle. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Inspect the machine, restore guards, account for people and tools, follow lock-removal rules and conduct a controlled functional test.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Restart slowly and reinstall nonessential guarding after several successful cycles. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "Return to normal speed once the machine powers up because the repair is complete.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "machine_guarding"
          ]
        }
      ]
    }
  ],
