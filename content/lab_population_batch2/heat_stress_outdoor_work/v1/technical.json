  "nodes": [
    {
      "id": "prejob_decision",
      "type": "DECISION",
      "prompt": "The crew is ready to begin strenuous work in high heat and one worker is not recently acclimatized. What should the supervisor do first?",
      "options": [
        {
          "id": "prejob_decision_o1",
          "text": "Provide extra water and remind the returning worker to take breaks if uncomfortable.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "prejob_decision_defensible",
          "mistakeTags": [
            "prejob_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "prejob_decision_o2",
          "text": "Assess heat conditions and workload, adjust the schedule and work-rest plan, provide shade and hydration, and add acclimatization controls.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "prejob_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "prejob_decision_o3",
          "text": "Send the crew out with shade equipment while the supervisor evaluates conditions after the first work cycle. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "prejob_decision_weak",
          "mistakeTags": [
            "prejob_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "prejob_decision_o4",
          "text": "Start on time because workers can stop independently if they feel overheated. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "prejob_decision_critical",
          "mistakeTags": [
            "prejob_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        }
      ]
    },
    {
      "id": "controls_decision",
      "type": "DECISION",
      "prompt": "The job is running late and the crew suggests skipping the next recovery break. What is the best action?",
      "options": [
        {
          "id": "controls_decision_o1",
          "text": "Allow experienced workers to shorten the break while the returning worker takes the full recovery period. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "controls_decision_defensible",
          "mistakeTags": [
            "controls_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "controls_decision_o2",
          "text": "Finish one more task segment before the next break if everyone drinks water first.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "controls_decision_weak",
          "mistakeTags": [
            "controls_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "controls_decision_o3",
          "text": "Skip the break because the remaining work is short. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "controls_decision_critical",
          "mistakeTags": [
            "controls_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "controls_decision_o4",
          "text": "Maintain or strengthen the heat-control plan based on current conditions rather than trading recovery controls for schedule.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "controls_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        }
      ]
    },
    {
      "id": "change_decision",
      "type": "DECISION",
      "prompt": "A worker becomes unusually fatigued, dizzy and nauseated but remains alert and wants to continue. What should happen?",
      "options": [
        {
          "id": "change_decision_o1",
          "text": "Stop the worker's heat exposure, move them to a cool area, begin appropriate first aid and evaluation, and do not return them until cleared.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "change_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "change_decision_o2",
          "text": "Give one shaded break and allow return if dizziness resolves. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "change_decision_defensible",
          "mistakeTags": [
            "change_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "change_decision_o3",
          "text": "Assign lighter work near the access point while a coworker monitors symptoms.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "change_decision_weak",
          "mistakeTags": [
            "change_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "change_decision_o4",
          "text": "Let the worker continue slowly because they remain alert and have started drinking water. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "change_decision_critical",
          "mistakeTags": [
            "change_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        }
      ]
    },
    {
      "id": "response_decision",
      "type": "DECISION",
      "prompt": "Another worker becomes confused and collapses during the same shift. What is the best response?",
      "options": [
        {
          "id": "response_decision_o1",
          "text": "Move the worker into shade and wait briefly to see whether mental status improves. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "response_decision_defensible",
          "mistakeTags": [
            "response_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "response_decision_o2",
          "text": "Transport the worker toward the clinic before beginning cooling so professional care starts sooner.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "response_decision_weak",
          "mistakeTags": [
            "response_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "response_decision_o3",
          "text": "Treat the condition as a medical emergency, activate emergency assistance and begin rapid cooling while help is on the way.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "response_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "response_decision_o4",
          "text": "Let the worker rest with cool packs while the supervisor completes a short assessment.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "response_decision_critical",
          "mistakeTags": [
            "response_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The emergency is under control but the site remains hot and the crew is short one experienced worker. What should happen before work resumes?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Reduce the task pace and restart while the supervisor updates the plan at the next break. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Reassess conditions, staffing, workload and controls, investigate the event and resume only with an adequate revised heat plan.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Resume only the lighter portions and complete the event review at the end of the shift.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "Continue the original plan because the affected worker has been removed. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "heat_stress"
          ]
        }
      ]
    }
  ],
