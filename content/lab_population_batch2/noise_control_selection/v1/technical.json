  "nodes": [
    {
      "id": "prejob_decision",
      "type": "DECISION",
      "prompt": "Workers report that a modified line is louder than before, but the most recent exposure survey predates the modification. What should happen first?",
      "options": [
        {
          "id": "prejob_decision_o1",
          "text": "Issue additional hearing protection and keep using the earlier survey until the annual review. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "prejob_decision_defensible",
          "mistakeTags": [
            "prejob_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "prejob_decision_o2",
          "text": "Reassess noise exposure under current operating conditions and use the results to select appropriate controls before assuming previous data remain valid.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "prejob_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "prejob_decision_o3",
          "text": "Ask workers whether the line feels significantly louder and measure only if several agree.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "prejob_decision_weak",
          "mistakeTags": [
            "prejob_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "prejob_decision_o4",
          "text": "Continue because the equipment change did not alter the posted hearing-protection area.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "prejob_decision_critical",
          "mistakeTags": [
            "prejob_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        }
      ]
    },
    {
      "id": "controls_decision",
      "type": "DECISION",
      "prompt": "Measurements confirm excessive noise near one machine while employees continue rotating through the area during production. What is the best next action?",
      "options": [
        {
          "id": "controls_decision_o1",
          "text": "Upgrade hearing protectors for everyone and postpone engineering review until the next shutdown. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "controls_decision_defensible",
          "mistakeTags": [
            "controls_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "controls_decision_o2",
          "text": "Rotate workers more frequently without evaluating whether total daily exposure is reduced sufficiently.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "controls_decision_weak",
          "mistakeTags": [
            "controls_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "controls_decision_o3",
          "text": "Keep the existing program because workers already wear hearing protection in the area.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "controls_decision_critical",
          "mistakeTags": [
            "controls_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "controls_decision_o4",
          "text": "Prioritize feasible engineering and administrative controls, then use suitable hearing protection for the remaining exposure within the hearing-conservation program.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "controls_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        }
      ]
    },
    {
      "id": "change_decision",
      "type": "DECISION",
      "prompt": "Production increases and workers now spend more time at the loudest station than during the assessment. What should happen?",
      "options": [
        {
          "id": "change_decision_o1",
          "text": "Reassess the exposure pattern and adjust controls or work organization so the revised duration is reflected in protection decisions.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "change_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "change_decision_o2",
          "text": "Keep the same controls because the sound level at the machine has not changed.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "change_decision_defensible",
          "mistakeTags": [
            "change_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "change_decision_o3",
          "text": "Tell workers to be more consistent with hearing protection and review exposure at the next scheduled survey. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "change_decision_weak",
          "mistakeTags": [
            "change_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "change_decision_o4",
          "text": "Continue because the increased time is temporary and the shift length is unchanged.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "change_decision_critical",
          "mistakeTags": [
            "change_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        }
      ]
    },
    {
      "id": "response_decision",
      "type": "DECISION",
      "prompt": "A noise enclosure door is found open and damaged during production. What is the best response?",
      "options": [
        {
          "id": "response_decision_o1",
          "text": "Close the damaged door as far as possible and continue until maintenance can repair it. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "response_decision_defensible",
          "mistakeTags": [
            "response_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "response_decision_o2",
          "text": "Move the nearest worker farther away but keep the rest of the line unchanged.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "response_decision_weak",
          "mistakeTags": [
            "response_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "response_decision_o3",
          "text": "Restore the engineering control, manage exposure while it is unavailable and verify effectiveness before returning to normal operation.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "response_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "response_decision_o4",
          "text": "Continue because hearing protection is already mandatory in the area. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "response_decision_critical",
          "mistakeTags": [
            "response_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The enclosure is repaired and staffing returns to the normal pattern. What should happen next?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Record the repair and wait for the next routine survey because the equipment is back to normal. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Verify the control performs as intended, document the change and confirm the exposure assessment and hearing-conservation measures remain appropriate.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Remove temporary controls as soon as the enclosure door closes properly. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "Resume normal arrangements because the original engineering design has been restored. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "noise"
          ]
        }
      ]
    }
  ],
