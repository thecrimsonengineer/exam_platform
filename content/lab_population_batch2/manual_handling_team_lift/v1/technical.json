  "nodes": [
    {
      "id": "prejob_decision",
      "type": "DECISION",
      "prompt": "A heavy awkward package must be moved through a narrow route, and its center of gravity is not obvious. What should the supervisor do first?",
      "options": [
        {
          "id": "prejob_decision_o1",
          "text": "Add a second worker and begin the move slowly while deciding how to turn through the narrow section. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "prejob_decision_defensible",
          "mistakeTags": [
            "prejob_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "prejob_decision_o2",
          "text": "Assess the load, route and handling method, use mechanical assistance where practicable and plan the move before anyone lifts.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "prejob_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "prejob_decision_o3",
          "text": "Have workers test-lift one end to judge the weight before selecting equipment. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "prejob_decision_weak",
          "mistakeTags": [
            "prejob_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "prejob_decision_o4",
          "text": "Proceed with a team lift because the package is within the normal weight range for the department.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "prejob_decision_critical",
          "mistakeTags": [
            "prejob_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        }
      ]
    },
    {
      "id": "controls_decision",
      "type": "DECISION",
      "prompt": "A suitable lifting aid is available, but the final placement requires a short manual transfer. What is the best action?",
      "options": [
        {
          "id": "controls_decision_o1",
          "text": "Move the package manually from storage so the team does not need to change methods near the workbench.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "controls_decision_defensible",
          "mistakeTags": [
            "controls_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "controls_decision_o2",
          "text": "Use the aid until the doorway, then let one experienced worker guide most of the load through the narrow section. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "controls_decision_weak",
          "mistakeTags": [
            "controls_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "controls_decision_o3",
          "text": "Carry the package manually because the final distance is short and the team has handled similar items before.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "controls_decision_critical",
          "mistakeTags": [
            "controls_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "controls_decision_o4",
          "text": "Use the aid for the maximum distance, prepare the final placement area and coordinate the short transfer with a clear team method.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "controls_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        }
      ]
    },
    {
      "id": "change_decision",
      "type": "DECISION",
      "prompt": "Material is placed in the planned route, forcing the team to make a tighter turn than assessed. What should happen?",
      "options": [
        {
          "id": "change_decision_o1",
          "text": "Stop the move, clear or redesign the route and reassess the handling method before continuing.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "change_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "change_decision_o2",
          "text": "Continue slowly and add a spotter at the tighter turn.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "change_decision_defensible",
          "mistakeTags": [
            "change_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "change_decision_o3",
          "text": "Set the load down temporarily inside the narrowed area and reposition workers before the turn.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "change_decision_weak",
          "mistakeTags": [
            "change_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "change_decision_o4",
          "text": "Continue because the load is already under control and the obstruction is temporary.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "change_decision_critical",
          "mistakeTags": [
            "change_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        }
      ]
    },
    {
      "id": "response_decision",
      "type": "DECISION",
      "prompt": "One worker loses grip and the load shifts unexpectedly during the transfer. What is the best response?",
      "options": [
        {
          "id": "response_decision_o1",
          "text": "Have the strongest worker take more of the load while the team completes the short remaining distance. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "response_decision_defensible",
          "mistakeTags": [
            "response_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "response_decision_o2",
          "text": "Ask the team to reset their grip without putting the package down. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "response_decision_weak",
          "mistakeTags": [
            "response_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "response_decision_o3",
          "text": "Stop the movement safely, stabilize the load without risky recovery actions, reassess the method and restart only after the cause is controlled.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "response_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "response_decision_o4",
          "text": "Continue because stopping abruptly may make the load harder to control. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "response_decision_critical",
          "mistakeTags": [
            "response_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The load is placed successfully at the workbench. What should happen before similar moves are repeated?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Return the lifting aid to storage and brief the next team only if they ask for help. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Review the handling method, route and equipment performance, capture any issues and standardize the safer approach for future moves.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Keep the same team together because their experience now compensates for the difficult route.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "Repeat the move using the same method because the first transfer was completed without injury.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "ergonomics"
          ]
        }
      ]
    }
  ],
