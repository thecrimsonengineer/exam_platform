  "nodes": [
    {
      "id": "prejob_decision",
      "type": "DECISION",
      "prompt": "A main pedestrian route is partly blocked by delivered materials while cleaning has left a nearby floor wet. What should the supervisor do first?",
      "options": [
        {
          "id": "prejob_decision_o1",
          "text": "Place warning signs around the wet area and ask workers to walk around the delivered materials.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "prejob_decision_defensible",
          "mistakeTags": [
            "prejob_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "prejob_decision_o2",
          "text": "Control the affected area, restore a safe route and remove or secure the obstructions before normal pedestrian flow continues.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "prejob_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "prejob_decision_o3",
          "text": "Leave the materials in place until receiving staff are available and direct pedestrians through the narrower gap. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "prejob_decision_weak",
          "mistakeTags": [
            "prejob_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "prejob_decision_o4",
          "text": "Continue because the conditions are visible and workers can choose another route. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "prejob_decision_critical",
          "mistakeTags": [
            "prejob_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        }
      ]
    },
    {
      "id": "controls_decision",
      "type": "DECISION",
      "prompt": "The delivery cannot be moved immediately. What is the best temporary arrangement?",
      "options": [
        {
          "id": "controls_decision_o1",
          "text": "Use cones to mark the edge of the remaining walkway and allow two-way pedestrian traffic through the gap. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "controls_decision_defensible",
          "mistakeTags": [
            "controls_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "controls_decision_o2",
          "text": "Ask one worker to warn pedestrians whenever a larger group approaches the obstruction.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "controls_decision_weak",
          "mistakeTags": [
            "controls_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "controls_decision_o3",
          "text": "Keep the normal route open because closing it may create congestion elsewhere. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "controls_decision_critical",
          "mistakeTags": [
            "controls_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "controls_decision_o4",
          "text": "Establish a clearly separated alternate route with adequate width and visibility, and maintain it until the normal walkway is restored.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "controls_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        }
      ]
    },
    {
      "id": "change_decision",
      "type": "DECISION",
      "prompt": "A maintenance cable is then routed across the temporary pedestrian path. What should happen?",
      "options": [
        {
          "id": "change_decision_o1",
          "text": "Stop use of the affected path, reroute or protect the cable and confirm the alternate route remains safe before reopening.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "change_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "change_decision_o2",
          "text": "Tape the cable to the floor and keep the route open while maintenance finishes the short task. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "change_decision_defensible",
          "mistakeTags": [
            "change_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "change_decision_o3",
          "text": "Tell pedestrians to step over the cable and place an additional warning sign nearby.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "change_decision_weak",
          "mistakeTags": [
            "change_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "change_decision_o4",
          "text": "Continue because the cable is visible and only crosses the path at one point.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "change_decision_critical",
          "mistakeTags": [
            "change_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        }
      ]
    },
    {
      "id": "response_decision",
      "type": "DECISION",
      "prompt": "A worker slips at the edge of the cleaned area but regains balance without injury. What is the best response?",
      "options": [
        {
          "id": "response_decision_o1",
          "text": "Add another wet-floor sign and let pedestrians continue using the route carefully.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "response_decision_defensible",
          "mistakeTags": [
            "response_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "response_decision_o2",
          "text": "Ask the worker whether footwear contributed and continue if the floor is nearly dry. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "response_decision_weak",
          "mistakeTags": [
            "response_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "response_decision_o3",
          "text": "Treat the near miss as evidence that controls are inadequate, correct the surface and route conditions and reassess before reopening.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "response_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "response_decision_o4",
          "text": "Continue because no injury occurred and the worker remained standing. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "response_decision_critical",
          "mistakeTags": [
            "response_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The floor is dry and all deliveries and cables are removed. What should occur before returning to normal layout?",
      "options": [
        {
          "id": "closeout_decision_o1",
          "text": "Remove barriers as soon as the floor appears dry and complete the inspection during normal use. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "closeout_decision_defensible",
          "mistakeTags": [
            "closeout_decision_defensible_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "closeout_decision_o2",
          "text": "Inspect the route, verify the original walking surface and access are fully restored, remove temporary controls and communicate reopening.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "closeout_decision_best",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "closeout_decision_o3",
          "text": "Open the route first and remove signs after observing several pedestrians pass safely.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "closeout_decision_weak",
          "mistakeTags": [
            "closeout_decision_weak_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        },
        {
          "id": "closeout_decision_o4",
          "text": "Return to normal immediately because the temporary hazards have been removed. while maintaining the documented work boundary and supervision.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "closeout_decision_critical",
          "mistakeTags": [
            "closeout_decision_critical_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "slips_and_trips"
          ]
        }
      ]
    }
  ],
