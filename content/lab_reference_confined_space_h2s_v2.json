  "nodes": [
    {
      "id": "permit_decision",
      "type": "DECISION",
      "prompt": "A contractor crew is ready to enter a vessel while nearby SIMOPS continue. What is your first action?",
      "options": [
        {
          "id": "p1",
          "text": "Stop entry, verify the permit and isolation, then confirm the worksite is ready.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "permit_safe",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "permit_review",
            "isolation"
          ]
        },
        {
          "id": "p2",
          "text": "Review the permit but accept the existing isolation status without independent confirmation.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "permit_defensible",
          "mistakeTags": [
            "verification_gap"
          ],
          "competencyEvidence": [
            "d07_c01",
            "permit_review"
          ]
        },
        {
          "id": "p3",
          "text": "Allow preparations to continue while the permit details are checked in parallel.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "permit_weak",
          "mistakeTags": [
            "simops_pressure",
            "work_before_verification"
          ],
          "competencyEvidence": [
            "d07_c01",
            "simops_reasoning"
          ]
        },
        {
          "id": "p4",
          "text": "Allow entry because the contractor supervisor says the vessel was made safe earlier.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "permit_critical",
          "mistakeTags": [
            "permit_bypass",
            "isolation_assumption"
          ],
          "competencyEvidence": [
            "d07_c01",
            "control_selection"
          ]
        }
      ]
    },
    {
      "id": "gas_decision",
      "type": "DECISION",
      "prompt": "The permit stage is complete. H2S may be present and nearby work can change conditions. What should happen next?",
      "options": [
        {
          "id": "g1",
          "text": "Verify atmospheric testing at the required locations and maintain monitoring for changing conditions.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "gas_safe",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "hazard_recognition",
            "information_gathering"
          ]
        },
        {
          "id": "g2",
          "text": "Repeat the gas test before entry and increase monitoring because SIMOPS may affect the atmosphere.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "gas_defensible",
          "mistakeTags": [
            "late_verification"
          ],
          "competencyEvidence": [
            "d07_c01",
            "risk_evaluation"
          ]
        },
        {
          "id": "g3",
          "text": "Rely on the earlier gas test unless someone reports an odour or alarm.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "gas_weak",
          "mistakeTags": [
            "stale_atmospheric_data"
          ],
          "competencyEvidence": [
            "d07_c01",
            "hazard_recognition"
          ]
        },
        {
          "id": "g4",
          "text": "Proceed without another test because ventilation has been running continuously.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "gas_critical",
          "mistakeTags": [
            "gas_test_bypass",
            "ventilation_assumption"
          ],
          "competencyEvidence": [
            "d07_c01",
            "control_selection"
          ]
        }
      ]
    },
    {
      "id": "simops_decision",
      "type": "DECISION",
      "prompt": "Entry is underway. Nearby line-breaking SIMOPS begins and the continuous H2S monitor shows a rising trend below the alarm set point. What do you do?",
      "options": [
        {
          "id": "s1",
          "text": "Stop the confined-space work, withdraw the entrant, suspend the permit and reassess the SIMOPS interface and atmosphere before any restart.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "simops_safe",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "simops_reasoning",
            "risk_evaluation",
            "control_selection"
          ]
        },
        {
          "id": "s2",
          "text": "Pause the work with the entrant in a safe position while the supervisor verifies the gas trend and conflicting activity before deciding on restart.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "simops_defensible",
          "mistakeTags": [
            "delayed_withdrawal"
          ],
          "competencyEvidence": [
            "d07_c01",
            "simops_reasoning",
            "information_gathering"
          ]
        },
        {
          "id": "s3",
          "text": "Continue the task with increased gas checks because the reading is still below the alarm set point.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "simops_weak",
          "mistakeTags": [
            "alarm_threshold_dependency",
            "changing_conditions_underestimated"
          ],
          "competencyEvidence": [
            "d07_c01",
            "risk_evaluation",
            "hazard_recognition"
          ]
        },
        {
          "id": "s4",
          "text": "Continue both activities because the permit is valid and the monitor has not yet reached the alarm set point.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "simops_critical",
          "mistakeTags": [
            "simops_conflict_ignored",
            "rising_h2s_ignored"
          ],
          "competencyEvidence": [
            "d07_c01",
            "simops_reasoning",
            "control_selection"
          ]
        }
      ]
    },
    {
      "id": "emergency_decision",
      "type": "DECISION",
      "prompt": "An H2S alarm occurs and a worker is unaccounted for. What emergency action do you take?",
      "options": [
        {
          "id": "e1",
          "text": "Raise the emergency response, prevent unprotected entry and use the planned rescue capability.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "emergency_recover",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response",
            "recovery_ability"
          ]
        },
        {
          "id": "e2",
          "text": "Evacuate and isolate the area while rescue resources are mobilised, without allowing spontaneous entry.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "emergency_contain",
          "mistakeTags": [
            "rescue_delay"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response"
          ]
        },
        {
          "id": "e3",
          "text": "Let a nearby worker approach the opening to assess the casualty while the rescue team is called.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "emergency_major",
          "mistakeTags": [
            "secondary_casualty_exposure"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response"
          ]
        },
        {
          "id": "e4",
          "text": "Send a colleague inside immediately to pull the worker out before conditions worsen.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "emergency_fatal",
          "mistakeTags": [
            "unplanned_rescue",
            "secondary_casualty"
          ],
          "competencyEvidence": [
            "d07_c01",
            "emergency_response"
          ]
        }
      ]
    },
    {
      "id": "closeout_decision",
      "type": "DECISION",
      "prompt": "The immediate situation is stable. How should the operation be closed out and recovered?",
      "options": [
        {
          "id": "c1",
          "text": "Keep the space closed, investigate causes, verify corrective actions and only then authorise restart.",
          "isBest": true,
          "quality": "OPTIMAL",
          "consequenceId": "close_safe",
          "mistakeTags": [],
          "competencyEvidence": [
            "d07_c01",
            "incident_investigation",
            "recovery_ability"
          ]
        },
        {
          "id": "c2",
          "text": "Maintain suspension, correct the identified failures and use a controlled restart review.",
          "isBest": false,
          "quality": "DEFENSIBLE",
          "consequenceId": "close_recovery",
          "mistakeTags": [
            "limited_investigation"
          ],
          "competencyEvidence": [
            "d07_c01",
            "recovery_ability"
          ]
        },
        {
          "id": "c3",
          "text": "Record the event and resume once the atmosphere is acceptable and the crew is re-briefed.",
          "isBest": false,
          "quality": "WEAK",
          "consequenceId": "close_contained",
          "mistakeTags": [
            "premature_restart"
          ],
          "competencyEvidence": [
            "d07_c01",
            "corrective_action"
          ]
        },
        {
          "id": "c4",
          "text": "Resume the task after ventilation clears the alarm because the delay is affecting the schedule.",
          "isBest": false,
          "quality": "CRITICAL",
          "consequenceId": "close_major",
          "mistakeTags": [
            "production_pressure",
            "restart_without_learning"
          ],
          "competencyEvidence": [
            "d07_c01",
            "risk_evaluation"
          ]
        }
      ]
    }
  ],
