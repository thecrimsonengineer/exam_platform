rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function allowedUserKeys() {
      return [
        'uid',
        'fullName',
        'email',
        'country',
        'phone',
        'organization',
        'jobTitle',
        'yearsExperience',
        'role',
        'createdAt',
        'updatedAt'
      ];
    }

    function requiredUserKeys() {
      return [
        'uid',
        'fullName',
        'email',
        'country',
        'role',
        'createdAt',
        'updatedAt'
      ];
    }

    function learnerMutableKeys() {
      return [
        'fullName',
        'country',
        'phone',
        'organization',
        'jobTitle',
        'yearsExperience',
        'updatedAt'
      ];
    }

    function validNewLearner(uid) {
      return request.resource.data.keys().hasAll(requiredUserKeys())
        && request.resource.data.keys().hasOnly(allowedUserKeys())
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.fullName is string
        && request.resource.data.email is string
        && request.resource.data.country is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validLearnerUpdate() {
      return request.resource.data.keys().hasAll(requiredUserKeys())
        && request.resource.data.keys().hasOnly(allowedUserKeys())
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly(learnerMutableKeys());
    }

    function examPlanAllowedKeys() {
      return [
        'id',
        'userId',
        'examDate',
        'timezone',
        'createdAt',
        'updatedAt',
        'active',
        'planVersion',
        'studyDaysOfWeek',
        'defaultMinutesPerStudyDay',
        'daySpecificMinutes',
        'preferredRestDays',
        'allowWeekendExtension',
        'maxDailyMinutes',
        'intensity',
        'preferredSessionLength',
        'preferredStartPeriod',
        'adaptiveSchedulingEnabled',
        'source',
        'schemaVersion',
        'serverUpdatedAt'
      ];
    }

    function validOwnedExamPlan(uid, planId) {
      return request.resource.data.keys().hasOnly(examPlanAllowedKeys())
        && request.resource.data.keys().hasAll([
          'id',
          'userId',
          'examDate',
          'timezone',
          'createdAt',
          'updatedAt',
          'active',
          'planVersion',
          'studyDaysOfWeek',
          'defaultMinutesPerStudyDay',
          'daySpecificMinutes',
          'preferredRestDays',
          'allowWeekendExtension',
          'maxDailyMinutes',
          'intensity',
          'preferredSessionLength',
          'preferredStartPeriod',
          'adaptiveSchedulingEnabled',
          'source',
          'schemaVersion'
        ])
        && request.resource.data.id == planId
        && request.resource.data.userId == uid
        && request.resource.data.id is string
        && request.resource.data.userId is string
        && request.resource.data.examDate is string
        && request.resource.data.timezone is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.active is bool
        && request.resource.data.planVersion is int
        && request.resource.data.studyDaysOfWeek is list
        && request.resource.data.defaultMinutesPerStudyDay is int
        && request.resource.data.daySpecificMinutes is map
        && request.resource.data.preferredRestDays is list
        && request.resource.data.allowWeekendExtension is bool
        && request.resource.data.maxDailyMinutes is int
        && request.resource.data.intensity is string
        && request.resource.data.preferredSessionLength is int
        && request.resource.data.preferredStartPeriod is string
        && request.resource.data.adaptiveSchedulingEnabled is bool
        && request.resource.data.source is string
        && request.resource.data.schemaVersion is int;
    }

    function validOwnedExamPlanUpdate(uid, planId) {
      return validOwnedExamPlan(uid, planId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.schemaVersion == resource.data.schemaVersion;
    }

    function evidenceSnapshotAllowedKeys() {
      return [
        'competencyId',
        'generatedAt',
        'schemaVersion',
        'algorithmVersion',
        'sourceAttemptCount',
        'coverage',
        'attempts',
        'cognition',
        'difficulty',
        'retention',
        'confidence',
        'recency',
        'evidenceQuality',
        'traceability',
        'serverUpdatedAt'
      ];
    }

    function validOwnedEvidenceSnapshot(competencyId) {
      return request.resource.data.keys().hasOnly(evidenceSnapshotAllowedKeys())
        && request.resource.data.keys().hasAll([
          'competencyId',
          'generatedAt',
          'schemaVersion',
          'algorithmVersion',
          'sourceAttemptCount',
          'coverage',
          'attempts',
          'cognition',
          'difficulty',
          'retention',
          'confidence',
          'recency',
          'evidenceQuality',
          'traceability'
        ])
        && request.resource.data.competencyId == competencyId
        && request.resource.data.competencyId is string
        && request.resource.data.generatedAt is string
        && request.resource.data.schemaVersion is int
        && request.resource.data.algorithmVersion is string
        && request.resource.data.sourceAttemptCount is int
        && request.resource.data.coverage is map
        && request.resource.data.attempts is map
        && request.resource.data.cognition is map
        && request.resource.data.difficulty is map
        && request.resource.data.retention is map
        && request.resource.data.confidence is map
        && request.resource.data.recency is map
        && request.resource.data.evidenceQuality is map
        && request.resource.data.traceability is list;
    }

    function readinessSnapshotAllowedKeys() {
      return [
        'competencyId',
        'generatedAt',
        'readinessAlgorithmVersion',
        'knowledgeMastery',
        'applicationAbility',
        'retention',
        'difficultyPerformance',
        'blueprintCoverage',
        'confidenceCalibration',
        'recentPerformance',
        'stability',
        'evidenceConfidence',
        'readinessState',
        'gaps',
        'limitingFactors',
        'explanationCodes',
        'serverUpdatedAt'
      ];
    }

    function validOwnedReadinessSnapshot(competencyId) {
      return request.resource.data.keys().hasOnly(readinessSnapshotAllowedKeys())
        && request.resource.data.keys().hasAll([
          'competencyId',
          'generatedAt',
          'readinessAlgorithmVersion',
          'knowledgeMastery',
          'applicationAbility',
          'retention',
          'difficultyPerformance',
          'blueprintCoverage',
          'confidenceCalibration',
          'recentPerformance',
          'stability',
          'evidenceConfidence',
          'readinessState',
          'gaps',
          'limitingFactors',
          'explanationCodes'
        ])
        && request.resource.data.competencyId == competencyId
        && request.resource.data.competencyId is string
        && request.resource.data.generatedAt is string
        && request.resource.data.readinessAlgorithmVersion is string
        && request.resource.data.knowledgeMastery is map
        && request.resource.data.applicationAbility is map
        && request.resource.data.retention is map
        && request.resource.data.difficultyPerformance is map
        && request.resource.data.blueprintCoverage is map
        && request.resource.data.confidenceCalibration is map
        && request.resource.data.recentPerformance is map
        && request.resource.data.stability is map
        && request.resource.data.evidenceConfidence is string
        && request.resource.data.readinessState is string
        && request.resource.data.gaps is list
        && request.resource.data.limitingFactors is list
        && request.resource.data.explanationCodes is list;
    }

    function dailyStudyPlanAllowedKeys() {
      return [
        'planId',
        'userId',
        'date',
        'generatedAt',
        'planVersion',
        'plannerAlgorithmVersion',
        'availableMinutes',
        'allocatedMinutes',
        'generationReason',
        'sourceEvidenceVersion',
        'sourceReadinessVersion',
        'blocks',
        'status',
        'schemaVersion',
        'serverUpdatedAt'
      ];
    }

    function validOwnedDailyStudyPlan(uid) {
      return request.resource.data.keys().hasOnly(dailyStudyPlanAllowedKeys())
        && request.resource.data.keys().hasAll([
          'planId',
          'userId',
          'date',
          'generatedAt',
          'planVersion',
          'plannerAlgorithmVersion',
          'availableMinutes',
          'allocatedMinutes',
          'generationReason',
          'sourceEvidenceVersion',
          'sourceReadinessVersion',
          'blocks',
          'status',
          'schemaVersion'
        ])
        && request.resource.data.userId == uid
        && request.resource.data.planId is string
        && request.resource.data.userId is string
        && request.resource.data.date is string
        && request.resource.data.generatedAt is string
        && request.resource.data.planVersion is int
        && request.resource.data.plannerAlgorithmVersion is string
        && request.resource.data.availableMinutes is int
        && request.resource.data.allocatedMinutes is int
        && request.resource.data.allocatedMinutes
          <= request.resource.data.availableMinutes
        && request.resource.data.generationReason is string
        && request.resource.data.sourceEvidenceVersion is string
        && request.resource.data.sourceReadinessVersion is string
        && request.resource.data.blocks is list
        && request.resource.data.status is string
        && request.resource.data.schemaVersion is int;
    }


    function labPublishedAllowedKeys() {
      return [
        'schemaVersion',
        'labId',
        'versionId',
        'lifecycle',
        'publishedJson',
        'publishedAt',
        'reviewerId',
        'validationAuthority',
        'qualityEvidenceJson',
        'exhaustiveRouteEvidenceJson',
        'publishEvidenceJson',
        'snapshotFingerprint',
        'serverCreatedAt'
      ];
    }

    function validLabPublishedVersion(versionKey) {
      return request.resource.data.keys().hasAll(labPublishedAllowedKeys())
        && request.resource.data.keys().hasOnly(labPublishedAllowedKeys())
        && versionKey == request.resource.data.labId + '__' + request.resource.data.versionId
        && request.resource.data.schemaVersion == 'csp11.lab.published_repository.v1'
        && request.resource.data.lifecycle == 'published'
        && request.resource.data.labId is string
        && request.resource.data.versionId is string
        && request.resource.data.publishedJson is string
        && request.resource.data.publishedAt is timestamp
        && request.resource.data.reviewerId == 'LSP-Q11-POPULATION-AUTO'
        && request.resource.data.validationAuthority == 'LSP-Q11-POPULATION-AUTO'
        && request.resource.data.qualityEvidenceJson is string
        && request.resource.data.exhaustiveRouteEvidenceJson is string
        && request.resource.data.publishEvidenceJson is string
        && request.resource.data.snapshotFingerprint is string
        && request.resource.data.serverCreatedAt is timestamp;
    }

    function labCatalogueAllowedKeys() {
      return [
        'schemaVersion',
        'available',
        'releaseId',
        'manifestEntryId',
        'labId',
        'versionId',
        'title',
        'summary',
        'focusTags',
        'estimatedTime',
        'decisionCountLabel',
        'decisionCount',
        'supportedModes',
        'presentation',
        'serverCreatedAt'
      ];
    }

    function validLabCatalogueEntry(versionKey) {
      return request.resource.data.keys().hasAll(labCatalogueAllowedKeys())
        && request.resource.data.keys().hasOnly(labCatalogueAllowedKeys())
        && versionKey == request.resource.data.labId + '__' + request.resource.data.versionId
        && request.resource.data.schemaVersion == 'csp11.lab.learner_catalogue.v1'
        && request.resource.data.available == true
        && request.resource.data.releaseId
          == 'phase_l_population_batch2_v1_q16_extension_v1'
        && request.resource.data.manifestEntryId is string
        && request.resource.data.labId is string
        && request.resource.data.versionId is string
        && request.resource.data.title is string
        && request.resource.data.summary is string
        && request.resource.data.focusTags is list
        && request.resource.data.estimatedTime is string
        && request.resource.data.decisionCountLabel is string
        && request.resource.data.decisionCount is int
        && request.resource.data.decisionCount > 0
        && request.resource.data.supportedModes is list
        && request.resource.data.presentation is map
        && request.resource.data.serverCreatedAt is timestamp;
    }

    function labProductionReleaseAllowedKeys() {
      return [
        'schemaVersion',
        'releaseId',
        'manifestId',
        'manifestFingerprint',
        'q14ClosureSha',
        'q14ValidationRunId',
        'environmentId',
        'executedBy',
        'executedAtIso',
        'labCount',
        'totalDecisionCount',
        'catalogueIdentityKeys',
        'entries',
        'evidenceFingerprint',
        'serverCreatedAt'
      ];
    }

    function validLabProductionRelease(releaseId) {
      return request.resource.data.keys().hasAll(labProductionReleaseAllowedKeys())
        && request.resource.data.keys().hasOnly(labProductionReleaseAllowedKeys())
        && releaseId == request.resource.data.releaseId
        && request.resource.data.schemaVersion == 'csp11.lab.production_release.v1'
        && request.resource.data.manifestId == 'phase_l_population_v1'
        && request.resource.data.q14ClosureSha == '5beee3db89a43267a4cc5b2956b117a344afe648'
        && request.resource.data.q14ValidationRunId == '35918656487'
        && request.resource.data.releaseId is string
        && request.resource.data.manifestFingerprint is string
        && request.resource.data.environmentId is string
        && request.resource.data.executedBy is string
        && request.resource.data.executedAtIso is string
        && request.resource.data.labCount == 10
        && request.resource.data.totalDecisionCount == 50
        && request.resource.data.catalogueIdentityKeys is list
        && request.resource.data.catalogueIdentityKeys.size() == 10
        && request.resource.data.entries is list
        && request.resource.data.entries.size() == 10
        && request.resource.data.evidenceFingerprint is string
        && request.resource.data.serverCreatedAt is timestamp;
    }


    function labLearnerReleaseStateAllowedKeys() {
      return [
        'schemaVersion',
        'releaseId',
        'manifestId',
        'released',
        'labCount',
        'totalDecisionCount',
        'evidenceFingerprint',
        'serverCreatedAt'
      ];
    }

    function validLabLearnerReleaseState(releaseId) {
      return request.resource.data.keys().hasAll(
          labLearnerReleaseStateAllowedKeys()
        )
        && request.resource.data.keys().hasOnly(
          labLearnerReleaseStateAllowedKeys()
        )
        && request.resource.data.schemaVersion
          == 'csp11.lab.learner_release_state.v1'
        && request.resource.data.releaseId == releaseId
        && request.resource.data.manifestId == 'phase_l_population_v1'
        && request.resource.data.released == true
        && request.resource.data.labCount == 10
        && request.resource.data.totalDecisionCount == 50
        && request.resource.data.evidenceFingerprint is string
        && request.resource.data.serverCreatedAt is timestamp
        && existsAfter(
          /databases/$(database)/documents/labProductionReleaseEvidence/$(releaseId)
        )
        && getAfter(
          /databases/$(database)/documents/labProductionReleaseEvidence/$(releaseId)
        ).data.evidenceFingerprint == request.resource.data.evidenceFingerprint;
    }


    function labProductionAcceptanceAllowedKeys() {
      return [
        'schemaVersion',
        'releaseId',
        'q16ClosureSha',
        'q16ValidationRunId',
        'environmentId',
        'manifestFingerprint',
        'evidenceFingerprint',
        'labCount',
        'totalDecisionCount',
        'acceptedBy',
        'acceptedAtIso',
        'acceptanceFingerprint',
        'serverCreatedAt'
      ];
    }

    function validLabProductionAcceptance(releaseId) {
      return request.resource.data.keys().hasAll(
          labProductionAcceptanceAllowedKeys()
        )
        && request.resource.data.keys().hasOnly(
          labProductionAcceptanceAllowedKeys()
        )
        && request.resource.data.schemaVersion
          == 'csp11.lab.production_release_acceptance.v1'
        && request.resource.data.releaseId == releaseId
        && request.resource.data.releaseId
          == 'phase_l_population_v1_q15_release_v1'
        && request.resource.data.q16ClosureSha
          == '04bfdc9d5c61faeb5a7a30e86cb753947ba8e49a'
        && request.resource.data.q16ValidationRunId == '35950731991'
        && request.resource.data.environmentId
          == 'firebase_project:csp11-exam-platform'
        && request.resource.data.manifestFingerprint is string
        && request.resource.data.evidenceFingerprint is string
        && request.resource.data.labCount == 10
        && request.resource.data.totalDecisionCount == 50
        && request.resource.data.acceptedBy is string
        && request.resource.data.acceptedAtIso is string
        && request.resource.data.acceptanceFingerprint is string
        && request.resource.data.serverCreatedAt is timestamp
        && exists(
          /databases/$(database)/documents/labProductionReleaseEvidence/$(releaseId)
        )
        && exists(
          /databases/$(database)/documents/labLearnerReleaseState/$(releaseId)
        )
        && get(
          /databases/$(database)/documents/labProductionReleaseEvidence/$(releaseId)
        ).data.environmentId == request.resource.data.environmentId
        && get(
          /databases/$(database)/documents/labProductionReleaseEvidence/$(releaseId)
        ).data.manifestFingerprint == request.resource.data.manifestFingerprint
        && get(
          /databases/$(database)/documents/labProductionReleaseEvidence/$(releaseId)
        ).data.evidenceFingerprint == request.resource.data.evidenceFingerprint
        && get(
          /databases/$(database)/documents/labLearnerReleaseState/$(releaseId)
        ).data.released == true
        && get(
          /databases/$(database)/documents/labLearnerReleaseState/$(releaseId)
        ).data.evidenceFingerprint == request.resource.data.evidenceFingerprint;
    }

    function initialLabPopulationReleased() {
      return exists(
          /databases/$(database)/documents/labLearnerReleaseState/phase_l_population_v1_q15_release_v1
        )
        && exists(
          /databases/$(database)/documents/labProductionReleaseEvidence/phase_l_population_v1_q15_release_v1
        )
        && get(
          /databases/$(database)/documents/labLearnerReleaseState/phase_l_population_v1_q15_release_v1
        ).data.schemaVersion == 'csp11.lab.learner_release_state.v1'
        && get(
          /databases/$(database)/documents/labLearnerReleaseState/phase_l_population_v1_q15_release_v1
        ).data.released == true
        && get(
          /databases/$(database)/documents/labLearnerReleaseState/phase_l_population_v1_q15_release_v1
        ).data.evidenceFingerprint == get(
          /databases/$(database)/documents/labProductionReleaseEvidence/phase_l_population_v1_q15_release_v1
        ).data.evidenceFingerprint;
    }


    function batch2StagingAllowedKeys() {
      return [
        'schemaVersion',
        'releaseId',
        'manifestEntryId',
        'labId',
        'versionId',
        'title',
        'summary',
        'focusTags',
        'estimatedTime',
        'decisionCountLabel',
        'decisionCount',
        'supportedModes',
        'presentation',
        'serverCreatedAt'
      ];
    }

    function validBatch2Staging() {
      return request.resource.data.keys().hasAll(batch2StagingAllowedKeys())
        && request.resource.data.keys().hasOnly(batch2StagingAllowedKeys())
        && request.resource.data.schemaVersion
          == 'csp11.lab.production_catalogue_staging.v1'
        && request.resource.data.releaseId
          == 'phase_l_population_batch2_v1_q16_extension_v1'
        && request.resource.data.manifestEntryId is string
        && request.resource.data.labId is string
        && request.resource.data.versionId is string
        && request.resource.data.title is string
        && request.resource.data.summary is string
        && request.resource.data.focusTags is list
        && request.resource.data.estimatedTime is string
        && request.resource.data.decisionCountLabel is string
        && request.resource.data.decisionCount is int
        && request.resource.data.decisionCount > 0
        && request.resource.data.supportedModes is list
        && request.resource.data.presentation is map
        && request.resource.data.serverCreatedAt is timestamp;
    }

    function batch2ReleaseEvidenceAllowedKeys() {
      return [
        'schemaVersion',
        'releaseId',
        'manifestId',
        'manifestFingerprint',
        'preCatalogueClosedSha',
        'preCatalogueValidationRunId',
        'environmentId',
        'executedBy',
        'executedAtIso',
        'labCount',
        'totalDecisionCount',
        'catalogueIdentityKeys',
        'entries',
        'evidenceFingerprint',
        'serverCreatedAt'
      ];
    }

    function validBatch2ReleaseEvidence(releaseId) {
      return request.resource.data.keys().hasAll(
          batch2ReleaseEvidenceAllowedKeys()
        )
        && request.resource.data.keys().hasOnly(
          batch2ReleaseEvidenceAllowedKeys()
        )
        && request.resource.data.schemaVersion
          == 'csp11.lab.production_extension_release.v1'
        && request.resource.data.releaseId == releaseId
        && releaseId == 'phase_l_population_batch2_v1_q16_extension_v1'
        && request.resource.data.manifestId == 'phase_l_population_batch2_v1'
        && request.resource.data.preCatalogueClosedSha
          == '8a3ee7a5e27ec4b63793dddbb3982e3f0f42c429'
        && request.resource.data.preCatalogueValidationRunId == '36015831093'
        && request.resource.data.environmentId
          == 'firebase_project:csp11-exam-platform'
        && request.resource.data.executedBy is string
        && request.resource.data.executedAtIso is string
        && request.resource.data.manifestFingerprint is string
        && request.resource.data.labCount == 10
        && request.resource.data.totalDecisionCount == 50
        && request.resource.data.catalogueIdentityKeys is list
        && request.resource.data.catalogueIdentityKeys.size() == 10
        && request.resource.data.entries is list
        && request.resource.data.entries.size() == 10
        && request.resource.data.evidenceFingerprint is string
        && request.resource.data.serverCreatedAt is timestamp;
    }

    function batch2ReleaseStateAllowedKeys() {
      return [
        'schemaVersion',
        'releaseId',
        'manifestId',
        'released',
        'labCount',
        'totalDecisionCount',
        'evidenceFingerprint',
        'serverCreatedAt'
      ];
    }

    function validBatch2ReleaseState(releaseId) {
      return request.resource.data.keys().hasAll(batch2ReleaseStateAllowedKeys())
        && request.resource.data.keys().hasOnly(batch2ReleaseStateAllowedKeys())
        && request.resource.data.schemaVersion
          == 'csp11.lab.production_extension_release_state.v1'
        && request.resource.data.releaseId == releaseId
        && releaseId == 'phase_l_population_batch2_v1_q16_extension_v1'
        && request.resource.data.manifestId == 'phase_l_population_batch2_v1'
        && request.resource.data.released == true
        && request.resource.data.labCount == 10
        && request.resource.data.totalDecisionCount == 50
        && request.resource.data.evidenceFingerprint is string
        && request.resource.data.serverCreatedAt is timestamp
        && existsAfter(
          /databases/$(database)/documents/labProductionReleaseExtensionEvidence/$(releaseId)
        )
        && getAfter(
          /databases/$(database)/documents/labProductionReleaseExtensionEvidence/$(releaseId)
        ).data.evidenceFingerprint == request.resource.data.evidenceFingerprint;
    }

    function batch2AcceptanceAllowedKeys() {
      return [
        'schemaVersion',
        'releaseId',
        'evidenceFingerprint',
        'environmentId',
        'labCount',
        'totalDecisionCount',
        'acceptedBy',
        'acceptedAtIso',
        'acceptanceFingerprint',
        'serverCreatedAt'
      ];
    }

    function validBatch2Acceptance(releaseId) {
      return request.resource.data.keys().hasAll(batch2AcceptanceAllowedKeys())
        && request.resource.data.keys().hasOnly(batch2AcceptanceAllowedKeys())
        && request.resource.data.schemaVersion
          == 'csp11.lab.production_extension_acceptance.v1'
        && request.resource.data.releaseId == releaseId
        && releaseId == 'phase_l_population_batch2_v1_q16_extension_v1'
        && request.resource.data.environmentId
          == 'firebase_project:csp11-exam-platform'
        && request.resource.data.labCount == 10
        && request.resource.data.totalDecisionCount == 50
        && request.resource.data.evidenceFingerprint is string
        && request.resource.data.acceptedBy is string
        && request.resource.data.acceptedAtIso is string
        && request.resource.data.acceptanceFingerprint is string
        && request.resource.data.serverCreatedAt is timestamp
        && exists(
          /databases/$(database)/documents/labProductionReleaseExtensionEvidence/$(releaseId)
        )
        && exists(
          /databases/$(database)/documents/labLearnerReleaseExtensionState/$(releaseId)
        )
        && get(
          /databases/$(database)/documents/labProductionReleaseExtensionEvidence/$(releaseId)
        ).data.evidenceFingerprint == request.resource.data.evidenceFingerprint
        && get(
          /databases/$(database)/documents/labLearnerReleaseExtensionState/$(releaseId)
        ).data.released == true
        && get(
          /databases/$(database)/documents/labLearnerReleaseExtensionState/$(releaseId)
        ).data.evidenceFingerprint == request.resource.data.evidenceFingerprint;
    }

    function batch2LabPopulationAccepted() {
      return exists(
          /databases/$(database)/documents/labProductionReleaseExtensionAcceptance/phase_l_population_batch2_v1_q16_extension_v1
        )
        && exists(
          /databases/$(database)/documents/labProductionReleaseExtensionEvidence/phase_l_population_batch2_v1_q16_extension_v1
        )
        && exists(
          /databases/$(database)/documents/labLearnerReleaseExtensionState/phase_l_population_batch2_v1_q16_extension_v1
        )
        && get(
          /databases/$(database)/documents/labProductionReleaseExtensionAcceptance/phase_l_population_batch2_v1_q16_extension_v1
        ).data.evidenceFingerprint == get(
          /databases/$(database)/documents/labProductionReleaseExtensionEvidence/phase_l_population_batch2_v1_q16_extension_v1
        ).data.evidenceFingerprint
        && get(
          /databases/$(database)/documents/labLearnerReleaseExtensionState/phase_l_population_batch2_v1_q16_extension_v1
        ).data.released == true
        && get(
          /databases/$(database)/documents/labLearnerReleaseExtensionState/phase_l_population_batch2_v1_q16_extension_v1
        ).data.evidenceFingerprint == get(
          /databases/$(database)/documents/labProductionReleaseExtensionEvidence/phase_l_population_batch2_v1_q16_extension_v1
        ).data.evidenceFingerprint;
    }

    function batch2LabPopulationAcceptedAfter() {
      return existsAfter(
          /databases/$(database)/documents/labProductionReleaseExtensionAcceptance/phase_l_population_batch2_v1_q16_extension_v1
        )
        && exists(
          /databases/$(database)/documents/labProductionReleaseExtensionEvidence/phase_l_population_batch2_v1_q16_extension_v1
        )
        && exists(
          /databases/$(database)/documents/labLearnerReleaseExtensionState/phase_l_population_batch2_v1_q16_extension_v1
        )
        && getAfter(
          /databases/$(database)/documents/labProductionReleaseExtensionAcceptance/phase_l_population_batch2_v1_q16_extension_v1
        ).data.evidenceFingerprint == get(
          /databases/$(database)/documents/labProductionReleaseExtensionEvidence/phase_l_population_batch2_v1_q16_extension_v1
        ).data.evidenceFingerprint;
    }

    match /users/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (isSelf(uid) && validNewLearner(uid));

      allow update: if isAdmin()
        || (isSelf(uid) && validLearnerUpdate());

      allow delete: if isAdmin();

      match /examPlans/{planId} {
        allow get, list: if isSelf(uid) || isAdmin();

        allow create: if isAdmin()
          || (isSelf(uid) && validOwnedExamPlan(uid, planId));

        allow update: if isAdmin()
          || (isSelf(uid) && validOwnedExamPlanUpdate(uid, planId));

        allow delete: if isAdmin() || isSelf(uid);
      }

      match /evidenceSnapshots/{competencyId} {
        allow get, list: if isSelf(uid) || isAdmin();

        allow create, update: if isAdmin()
          || (isSelf(uid) && validOwnedEvidenceSnapshot(competencyId));

        allow delete: if isAdmin() || isSelf(uid);
      }

      match /readinessSnapshots/{competencyId} {
        allow get, list: if isSelf(uid) || isAdmin();

        allow create, update: if isAdmin()
          || (isSelf(uid) && validOwnedReadinessSnapshot(competencyId));

        allow delete: if isAdmin() || isSelf(uid);
      }

      match /dailyStudyPlans/{planVersionId} {
        allow get, list: if isSelf(uid) || isAdmin();

        allow create: if isAdmin()
          || (isSelf(uid) && validOwnedDailyStudyPlan(uid));

        // Historical plan versions are immutable for learners.
        allow update, delete: if isAdmin();
      }
    }

    match /questions/{questionId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.status == 'published');

      allow create, update, delete: if isAdmin();
    }

    match /contentVersions/{contentVersionId} {
      allow get, list: if isAdmin()
        || (
          signedIn()
          && resource.data.copyType == 'published'
          && resource.data.status == 'published'
        );

      allow create, update, delete: if isAdmin();
    }


    match /labPublishedVersions/{versionKey} {
      allow get: if isAdmin()
        || (
          signedIn()
          && batch2LabPopulationAccepted()
          && resource.data.schemaVersion == 'csp11.lab.published_repository.v1'
          && resource.data.lifecycle == 'published'
          && exists(
            /databases/$(database)/documents/labLearnerCatalogue/$(versionKey)
          )
          && get(
            /databases/$(database)/documents/labLearnerCatalogue/$(versionKey)
          ).data.releaseId
            == 'phase_l_population_batch2_v1_q16_extension_v1'
          && get(
            /databases/$(database)/documents/labLearnerCatalogue/$(versionKey)
          ).data.available == true
        );

      allow list: if isAdmin();

      allow create: if isAdmin() && validLabPublishedVersion(versionKey);

      allow update, delete: if false;
    }

    match /labLearnerCatalogue/{versionKey} {
      allow get, list: if isAdmin()
        || (
          signedIn()
          && batch2LabPopulationAccepted()
          && resource.data.schemaVersion == 'csp11.lab.learner_catalogue.v1'
          && resource.data.available == true
          && resource.data.releaseId
            == 'phase_l_population_batch2_v1_q16_extension_v1'
        );

      allow create: if isAdmin()
        && validLabCatalogueEntry(versionKey)
        && batch2LabPopulationAcceptedAfter();

      allow update, delete: if false;
    }

    match /labProductionCatalogueStaging/{stagingId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin() && validBatch2Staging();

      allow update, delete: if false;
    }

    match /labProductionReleaseExtensionEvidence/{releaseId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin() && validBatch2ReleaseEvidence(releaseId);

      allow update, delete: if false;
    }

    match /labLearnerReleaseExtensionState/{releaseId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin() && validBatch2ReleaseState(releaseId);

      allow update, delete: if false;
    }

    match /labProductionReleaseExtensionAcceptance/{releaseId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin() && validBatch2Acceptance(releaseId);

      allow update, delete: if false;
    }


    match /labProductionReleaseEvidence/{releaseId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin() && validLabProductionRelease(releaseId);

      allow update, delete: if false;
    }


    match /labProductionReleaseAcceptance/{releaseId} {
      allow get, list: if isAdmin();

      allow create: if isAdmin()
        && validLabProductionAcceptance(releaseId);

      allow update, delete: if false;
    }


    match /labLearnerReleaseState/{releaseId} {
      allow get: if isAdmin()
        || (
          signedIn()
          && resource.data.schemaVersion == 'csp11.lab.learner_release_state.v1'
          && resource.data.released == true
        );

      allow list: if isAdmin();

      allow create: if isAdmin()
        && validLabLearnerReleaseState(releaseId);

      allow update, delete: if false;
    }

    // Fail closed for every Firestore path not explicitly declared above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
